  , experimentalPrivilegedNesting :: Maybe Boolean
  , insecureRootCapabilities :: Maybe Boolean
  }

defaultWithShellOpts :: WithShellOpts
defaultWithShellOpts =
  { batch: Nothing
  , disableDaggerInDagger: Nothing
  , experimentalPrivilegedNesting: Nothing
  , insecureRootCapabilities: Nothing
  }

-- | Set the shell used by terminal() and withRun().
withShell :: (Array String) -> T.Container -> T.Container
withShell argInteractive = withShellWith argInteractive defaultWithShellOpts

-- | Set the shell used by terminal() and withRun().
withShellWith :: (Array String) -> WithShellOpts -> T.Container -> T.Container
withShellWith argInteractive opts = R.select "withShell" [R.argument "interactive" "[String!]!" argInteractive, R.optional (R.argument "batch" "[String!]") opts.batch, R.optional (R.argument "disableDaggerInDagger" "Boolean") opts.disableDaggerInDagger, R.optional (R.argument "experimentalPrivilegedNesting" "Boolean") opts.experimentalPrivilegedNesting, R.optional (R.argument "insecureRootCapabilities" "Boolean") opts.insecureRootCapabilities]

type WithSymlinkOpts =
  { expand :: Maybe Boolean
  }


-- | Change the container's working directory. Like WORKDIR in Dockerfile.
withWorkdirWith :: String -> WithWorkdirOpts -> T.Container -> T.Container
withWorkdirWith argPath opts = R.select "withWorkdir" [R.argument "path" "String!" argPath, R.optional (R.argument "expand" "Boolean") opts.expand]


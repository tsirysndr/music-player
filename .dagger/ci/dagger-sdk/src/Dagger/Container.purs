  { expand: Nothing
  }

-- | Return a snapshot with a symlink
withSymlink :: String -> String -> T.Container -> T.Container
withSymlink argTarget argLinkName = withSymlinkWith argTarget argLinkName defaultWithSymlinkOpts

-- | Return a snapshot with a symlink
withSymlinkWith :: String -> String -> WithSymlinkOpts -> T.Container -> T.Container
withSymlinkWith argTarget argLinkName opts = R.select "withSymlink" [R.argument "target" "String!" argTarget, R.argument "linkName" "String!" argLinkName, R.optional (R.argument "expand" "Boolean") opts.expand]

type WithUnixSocketOpts =
  { owner :: Maybe String
  , inheritOwner :: Maybe Boolean
  , expand :: Maybe Boolean
  }

defaultWithUnixSocketOpts :: WithUnixSocketOpts
defaultWithUnixSocketOpts =
  { owner: Nothing
  , inheritOwner: Nothing
  , expand: Nothing
  }

-- | Retrieves this container plus a socket forwarded to the given Unix socket path.
withUnixSocket :: String -> T.Socket -> T.Container -> T.Container
withUnixSocket argPath argSource = withUnixSocketWith argPath argSource defaultWithUnixSocketOpts

-- | Retrieves this container plus a socket forwarded to the given Unix socket path.
withUnixSocketWith :: String -> T.Socket -> WithUnixSocketOpts -> T.Container -> T.Container
withUnixSocketWith argPath argSource opts = R.select "withUnixSocket" [R.argument "path" "String!" argPath, R.objectArgument "source" "ID!" argSource, R.optional (R.argument "owner" "String") opts.owner, R.optional (R.argument "inheritOwner" "Boolean") opts.inheritOwner, R.optional (R.argument "expand" "Boolean") opts.expand]

-- | Retrieves this container with a different command user.
withUser :: String -> T.Container -> T.Container
withUser argName = R.select "withUser" [R.argument "name" "String!" argName]

-- | Set a new non-secret environment variable for future execs without invalidating exec cache when only its value changes.
-- |
-- | This is an expert-only escape hatch. If a volatile value affects observable exec results, stale cached results may be reused.
withVolatileVariable :: String -> String -> T.Container -> T.Container
withVolatileVariable argName argValue = R.select "withVolatileVariable" [R.argument "name" "String!" argName, R.argument "value" "String!" argValue]


#!/usr/bin/env bash
# Run one or more jobs locally. No arguments means test, then build.
set -euo pipefail
cd "$(dirname "$0")/.."
source_dir=${SOURCE:-.}
platform=${PLATFORM:-linux/amd64}
target=${TARGET:-x86_64-unknown-linux-gnu}
tag=${TAG:-latest}
if [ "$#" -eq 0 ]; then set -- pipeline; fi
for job in "$@"; do
  case "$job" in
    test|clippy)
      report=lcov.info
      if [ "$job" = clippy ]; then report=rust-clippy-results.sarif; fi
      mise exec -- dagger --progress logs -v api call -m .dagger/ci "$job" --source "$source_dir" --platform "$platform" export --path "artifacts/$report"
      ;;
    build)
      mise exec -- dagger --progress logs -v api call -m .dagger/ci build --source "$source_dir" --target "$target" --tag "$tag" export --path artifacts
      ;;
    pipeline)
      mise exec -- dagger --progress logs -v api call -m .dagger/ci pipeline --source "$source_dir" --platform "$platform" --target "$target" --tag "$tag" export --path artifacts
      ;;
    *) echo "Unknown job: $job (expected test, clippy, build, or pipeline)" >&2; exit 2 ;;
  esac
done

import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import {
    TrackItem, AlbumItem, ArtistItem,
    IconButton, PlayPauseButton, SlideBar, VfdDisplay,
    SidebarItem, AlbumCard, TrackRow, TrackListHeader, ArtistRow,
    SearchButton, PaletteItem, PaletteRow, HelpRow,
    EqBand, Toggle, Dropdown, SettingRow, EqBandSlider, SectionHeader, Knob,
    DetailRow, ServerItem, FormField, ServerRow, RendererItem, RendererRow,
    PlaylistItem, PlaylistRow, CtxMenuItem, LikeButton, StationItem, RadioRow, RadioCategoryTile,
    RadioSkeletonList, RadioFilterBox, MarqueeText, FilterBox, SyntaxRun, FilterSuggestion,
    TrackSkeletonList, AlbumSkeletonCard, ArtistSkeletonList, PlaylistSkeletonList,
    ExtensionItem, ExtensionRow
} from "components.slint";
import { Icons } from "icons.slint";

export { Theme }

export component AppWindow inherits Window {
    title: "Music Player";
    preferred-width: 1200px;
    preferred-height: 780px;
    min-width: 860px;
    min-height: 560px;
    background: Theme.window-bg;
    default-font-family: Theme.font-ui;

    // ── Library data ────────────────────────────────────────────────────────
    in-out property <[AlbumItem]> albums: [];
    in-out property <[ArtistItem]> artists: [];
    in-out property <[TrackItem]> tracks: [];
    in-out property <[TrackItem]> liked: [];

    // ── Now playing ─────────────────────────────────────────────────────────
    in-out property <string> now-title: "Nothing playing";
    in-out property <string> now-artist: "";
    in-out property <string> now-album: "";
    in-out property <string> now-path: "";
    in-out property <string> now-cover-url: "";
    in-out property <string> now-track-id: "";
    in-out property <bool> now-liked: false;
    in-out property <image> now-art;
    in-out property <bool> now-has-art: false;
    in-out property <image> now-art-blurred;
    in-out property <bool> now-is-radio: false;
    // Station id (no `radio:` prefix) and whether it is bookmarked, so the
    // player bar's heart can toggle the bookmark like anywhere else.
    in-out property <string> now-station-id: "";
    in-out property <bool> now-radio-bookmarked: false;
    // Second line of the player bar. For a station the album slot holds the
    // station name, so once ICY metadata names the song on the air this reads
    // "Artist · Station"; before that the title already IS the station name,
    // so the repeat is dropped.
    property <bool> show-station: root.now-album != ""
        && root.now-album != root.now-artist
        && root.now-album != root.now-title;
    property <string> now-subtitle: !root.now-is-radio || !root.show-station
        ? root.now-artist
        : (root.now-artist != "" ? root.now-artist + " · " + root.now-album : root.now-album);
    in-out property <bool> playing: false;
    in-out property <bool> stopped: true;
    in-out property <float> progress: 0; // 0..1
    in-out property <float> elapsed-s: 0;
    in-out property <float> length-s: 0;
    in-out property <string> elapsed-text: "00:00";
    in-out property <string> duration-text: "00:00";
    in-out property <string> vfd-info: "--- kbps   --.- kHz";
    in-out property <float> vu-left: 0;
    in-out property <float> vu-right: 0;
    // The current track's waveform, 0..1 per bar, already resampled to the
    // number of bars the full player draws. Empty until the track has been
    // analysed — the player then shows a flat line rather than nothing, so the
    // layout does not jump when the analysis arrives.
    in-out property <[float]> waveform-bars: [];
    // How far through, 0..1. Drives which bars read as played.
    in-out property <float> waveform-progress: 0;
    // Equalizer bar heights, 0..1, recomputed from the output levels on every
    // tick. Computed in Rust rather than here because it is the same shaping
    // the web client uses, and one description of it is enough.
    in-out property <[float]> eq-bars: [];
    // The level each bar most recently reached, for the floating caps.
    in-out property <[float]> eq-peaks: [];
    // Whether the library being read can report a key and a tempo. Only a
    // music-player daemon analyses its own tracks; against Subsonic or
    // Jellyfin the columns are hidden rather than shown blank for every row.
    in-out property <bool> provider-analyses: true;
    // Whether the equalizer is drawn. On by default — it is the point of the
    // full player for most people — and `v` turns it off for anyone who wants
    // only the artwork.
    in-out property <bool> show-equalizer: true;
    in-out property <float> volume: 0.75;
    // Muted at the daemon, which keeps `volume` — unmuting restores the level
    // rather than guessing one.
    in-out property <bool> muted: false;
    in-out property <bool> shuffle: false;
    in-out property <int> repeat-mode: 0; // 0 off, 1 all, 2 one

    // ── App state ───────────────────────────────────────────────────────────
    in-out property <int> current-tab: 0; // 0 albums, 1 artists, 2 tracks, 3 liked
    in-out property <bool> show-detail: false;
    /// The album detail is open but its tracks are still in flight. The page
    /// shows placeholder rows rather than an empty table.
    in-out property <bool> detail-loading: false;
    in-out property <AlbumItem> detail-album;
    in-out property <string> detail-meta: "";
    in-out property <string> detail-label: "";
    in-out property <[DetailRow]> detail-tracks: [];
    // Artist detail — the same shape as the album detail, one level up: the
    // artist's albums as a grid and every one of their songs below it.
    in-out property <bool> show-artist: false;
    in-out property <ArtistItem> artist-detail;
    in-out property <string> artist-detail-meta: "";
    in-out property <[AlbumItem]> artist-detail-albums: [];
    in-out property <[TrackItem]> artist-detail-tracks: [];
    // ── Audio settings (firmware units; see rpc.rs AudioSettingsData) ───────
    in-out property <bool> show-audio: false;
    in-out property <bool> eq-enabled: false;
    in-out property <int> eq-precut: 0; // dB x10, 0..240
    in-out property <[EqBand]> eq-bands: [];
    in-out property <int> bass: 0;
    in-out property <int> bass-min: -24;
    in-out property <int> bass-max: 24;
    in-out property <int> treble: 0;
    in-out property <int> treble-min: -24;
    in-out property <int> treble-max: 24;
    in-out property <int> balance: 0; // -100..100
    in-out property <int> rg-type: 3; // 0 track, 1 album, 2 track-shuffle, 3 off
    in-out property <int> rg-preamp: 0; // dB x10, -120..120
    in-out property <bool> rg-noclip: false;
    in-out property <int> crossfade: 0; // 0..5
    in-out property <int> fade-in-delay: 0; // s, 0..7
    in-out property <int> fade-in-duration: 0; // s, 0..15
    in-out property <int> fade-out-delay: 0; // s, 0..7
    in-out property <int> fade-out-duration: 0; // s, 0..15
    in-out property <int> fade-out-mixmode: 0; // 0 crossfade, 2 mix
    in-out property <bool> dithering: false;

    // ── Playlists ───────────────────────────────────────────────────────────
    in-out property <[PlaylistItem]> playlists: [];
    in-out property <bool> pl-detail-open: false;
    /// The playlist page is open but its tracks are still in flight.
    in-out property <bool> pl-detail-loading: false;
    in-out property <PlaylistItem> pl-detail;
    in-out property <[TrackItem]> pl-detail-tracks: [];
    in-out property <bool> show-playlist-form: false;
    in-out property <string> pl-form-id: ""; // empty = create
    in-out property <string> pl-form-name: "";
    in-out property <string> pl-form-desc: "";
    /// A smart playlist fills itself from a filter instead of from tracks the
    /// user picks, so turning this on replaces the track picker with the rule
    /// fields below.
    in-out property <bool> pl-form-smart: false;
    in-out property <string> pl-form-rsql: "";
    in-out property <string> pl-form-sort-by: "";
    in-out property <string> pl-form-sort-order: "asc";
    in-out property <string> pl-form-limit: "";
    /// Live preview of what the filter matches, refreshed as it is typed.
    in-out property <int> pl-form-preview-count: -1;
    in-out property <string> pl-form-preview-error: "";
    in-out property <bool> pl-form-previewing: false;
    /// Track fields a filter may mention, as one line of hint text under the
    /// filter box. Built in Rust from the daemon's field list.
    in-out property <string> rsql-hint: "";
    /// The filter, coloured by role. Recomputed in Rust on every edit.
    in-out property <[SyntaxRun]> rsql-runs: [];
    in-out property <[FilterSuggestion]> rsql-suggestions: [];
    in-out property <int> rsql-suggestion-index: 0;
    /// Bumped after a completion is spliced in, so the box moves its caret.
    in-out property <int> rsql-caret-bump: 0;
    /// The filter text before the caret, sliced in Rust. The box measures it
    /// to place its own caret — Slint draws none for a transparent input.
    in-out property <string> rsql-caret-prefix: "";
    in-out property <bool> show-track-picker: false;
    in-out property <[PaletteItem]> picker-results: [];
    in-out property <bool> show-playlist-picker: false;
    in-out property <string> plpicker-track-id: "";
    in-out property <[PaletteItem]> plpicker-results: [];
    in-out property <int> plpicker-sel: 0;
    in-out property <bool> show-confirm-delete: false;
    in-out property <string> confirm-delete-id: "";
    in-out property <string> confirm-delete-name: "";

    // ── Remote servers ──────────────────────────────────────────────────────
    in-out property <[ServerItem]> servers: [];
    in-out property <bool> show-server-form: false;
    in-out property <bool> show-server-switcher: false;
    in-out property <[PaletteItem]> switcher-results: [];
    in-out property <int> switcher-sel: 0;
    /// Why the last connect attempt failed. Empty when it did not.
    in-out property <string> server-error: "";
    /// The provider the library screens are reading from. Empty means the
    /// daemon's own library.
    in-out property <string> provider-name: "";
    in-out property <string> provider-url: "";

    in-out property <bool> show-help: false;
    in-out property <bool> show-palette: false;
    in-out property <[PaletteItem]> palette-results: [];
    in-out property <int> palette-sel: 0;
    in-out property <bool> show-queue: false;
    in-out property <int> queue-tab: 0; // 0 play queue, 1 history
    in-out property <[TrackItem]> queue-upnext: [];
    in-out property <[TrackItem]> queue-history: [];
    in-out property <int> queue-total: 0;
    in-out property <bool> connected: false;
    in-out property <string> skin-name: "Synthwave";
    in-out property <string> status-text: "connecting…";
    // Height reserved at the top of the sidebar for the macOS traffic-light
    // buttons (set from Rust; 0 on other platforms).
    in-out property <length> titlebar-inset: 0px;
    in-out property <bool> show-sidebar: true;
    in-out property <bool> show-full-player: false;

    // ── Extensions ─────────────────────────────────────────────────────────
    in-out property <[ExtensionItem]> extensions: [];
    /// Search over the installed extensions, filtered on the Rust side so it
    /// can reach the fields the row does not show (topics, id).
    in-out property <string> extension-filter: "";
    in-out property <bool> extensions-loading: true;
    /// The first library fetch is in flight. Every list screen shows its
    /// placeholder rows until it lands — including after a server switch,
    /// which re-reads everything.
    in-out property <bool> library-loading: true;
    /// Quick filter by state: 0 all, 1 enabled, 2 disabled. Applied on the
    /// Rust side alongside the text search.
    in-out property <int> extension-state-filter: 0;

    // ── Internet radio ─────────────────────────────────────────────────────
    in-out property <[StationItem]> radios: [];
    in-out property <int> radio-tab: 0; // 0 search/categories, 1 bookmarks, 2 own stations
    in-out property <string> radio-category: "";
    in-out property <bool> show-radio-search: false;
    in-out property <bool> radio-loading: false;
    /// Quick filter over the station list currently on screen.
    in-out property <string> radio-filter: "";

    // ── Add-station form ───────────────────────────────────────────────────
    in-out property <bool> show-add-station: false;
    in-out property <string> add-station-name: "";
    in-out property <string> add-station-url: "";
    in-out property <string> add-station-genre: "";
    in-out property <string> add-station-country: "";
    in-out property <string> add-station-logo: "";
    /// Verdict on the stream url: the form will not save a url the station
    /// itself does not answer.
    in-out property <string> add-station-status: "";
    in-out property <bool> add-station-ok: false;
    in-out property <bool> add-station-checking: false;
    in-out property <bool> add-station-saving: false;

    // ── Callbacks into Rust ─────────────────────────────────────────────────
    callback play-pause();
    callback next();
    callback previous();
    callback seek(float);
    callback set-volume(float);
    callback set-mute(bool);

    /// Nudge the volume by `delta` and unmute: asking for a level is asking to
    /// hear it.
    public function bump-volume(delta: float) {
        root.volume = clamp(root.volume + delta, 0.0, 1.0);
        if (root.muted) {
            root.muted = false;
            root.set-mute(false);
        }
        root.set-volume(root.volume);
    }
    public function toggle-mute() {
        root.muted = !root.muted;
        root.set-mute(root.muted);
    }
    callback play-album(string);
    callback play-album-shuffled(string);
    callback toggle-shuffle();
    callback cycle-repeat();
    callback open-album(string);
    callback play-album-track(string, int);
    callback play-artist(string);
    callback play-artist-shuffled(string);
    callback play-artist-at(string, int);
    callback open-artist(string);
    callback play-track-at(int);
    callback play-liked-at(int);
    callback play-liked();
    callback play-liked-shuffled();
    callback track-like(string);
    callback track-insert(string, int); // id, rockbox position (-2 next, -3 last)
    callback album-insert(string, int);
    callback album-like(string);
    callback track-add-to-playlist(string, string); // playlist id, track id
    callback playlists-open(string);
    callback playlist-play(string);
    callback playlist-shuffle(string);
    callback playlist-delete(string);
    callback playlist-form-submit(string, string, string); // id ("" = create), name, desc
    // id ("" = create), name, desc, rsql, sort-by, sort-order, limit
    callback smart-playlist-submit(string, string, string, string, string, string, string);
    callback smart-playlist-preview(string, string, string); // rsql, sort-by, limit
    /// The filter changed: recompute the colouring and the suggestions.
    callback rsql-edited(string);
    /// A suggestion was accepted; Rust splices it in and hands back the result.
    callback rsql-accept(string);
    /// The caret moved without an edit; Rust re-slices the prefix.
    callback rsql-caret-moved(int);
    callback playlist-remove-track(string); // track id
    callback picker-query(string);
    callback plpicker-query(string);
    callback picker-add(string); // track id
    callback switcher-opened();
    callback switcher-query(string);
    callback switcher-activate(PaletteItem);
    callback server-add(string, string, string, string, string); // kind,name,url,user,pass
    callback server-delete(int);
    callback server-connect(int);
    /// Read the library from the daemon's own files again.
    callback server-disconnect();

    // ── Account (atproto) ───────────────────────────────────────────────────
    /// Empty when nobody is signed in.
    in-out property <string> account-handle: "";
    in-out property <string> account-name: "";
    in-out property <image> account-avatar;
    in-out property <bool> account-has-avatar: false;
    in-out property <bool> show-signin: false;
    in-out property <bool> signin-busy: false;
    /// Why the daemon refused. Empty when it did not.
    in-out property <string> signin-error: "";
    callback sign-in(string, string); // handle, app password
    callback sign-out();
    /// Re-read the saved servers from the daemon.
    callback servers-refresh();

    // ── Renderers (where the audio comes out) ───────────────────────────────
    in-out property <bool> show-renderers: false;
    in-out property <[RendererItem]> renderers: [];
    /// The renderer currently playing, empty for this machine.
    in-out property <string> current-renderer: "";
    callback renderers-open();
    /// id, cast — an empty id means "play here".
    callback renderer-activate(string, bool);
    callback audio-set(string, int);
    callback eq-band-set(int, int);
    callback palette-query(string);
    callback palette-activate(PaletteItem);
    callback play-queue-at(int);
    callback queue-clear();
    callback queue-remove(int);
    callback cycle-skin();
    /// Re-scan the extension directories and re-apply the filter.
    callback extensions-refresh();
    callback extension-filter-changed(string);
    /// Switch one on or off. The row does not change until the rescan that
    /// follows confirms it.
    callback extension-set-enabled(string, bool);
    callback radio-search(string);
    callback radio-browse(string);
    callback radio-bookmarks();
    callback radio-play(string);
    callback radio-bookmark(string);
    callback radio-filter-changed(string);
    callback radio-stations();
    callback radio-check-stream(string);
    callback radio-add-station(string, string, string, string, string); // name,url,genre,country,logo

    forward-focus: main-focus;

    // ── Focus ───────────────────────────────────────────────────────────────
    //
    // Every overlay here contains a TextInput, and while one is open that input
    // holds the keyboard. Closing the overlay destroys it — and unless focus is
    // handed back explicitly, nothing has it and every global shortcut stops
    // working until the user clicks something.
    //
    // Restoring focus at each dismissal site was the previous approach and it
    // did not hold: there are dozens of them (buttons, backdrops, Escape, and
    // the Rust side), and the ones that were missed are why shortcuts worked
    // only sometimes. Watching the flags themselves covers every path, including
    // ones added later.
    changed show-playlist-form => { root.reclaim-focus(); }
    changed show-server-form => { root.reclaim-focus(); }
    changed show-add-station => { root.reclaim-focus(); }
    changed show-radio-search => { root.reclaim-focus(); }
    changed show-track-picker => { root.reclaim-focus(); }
    changed show-playlist-picker => { root.reclaim-focus(); }
    changed show-palette => { root.reclaim-focus(); }
    changed show-server-switcher => { root.reclaim-focus(); }
    changed show-confirm-delete => { root.reclaim-focus(); }
    changed show-help => { root.reclaim-focus(); }
    changed show-audio => { root.reclaim-focus(); }

    /// Give the keyboard back to the main scope, unless another overlay is
    /// still open — closing one of two stacked overlays must not steal focus
    /// from the one underneath.
    function reclaim-focus() {
        if (!root.show-playlist-form
            && !root.show-server-form
            && !root.show-add-station
            && !root.show-radio-search
            && !root.show-track-picker
            && !root.show-playlist-picker
            && !root.show-palette
            && !root.show-server-switcher
            && !root.show-confirm-delete) {
            main-focus.focus();
        }
    }

    public function open-palette() {
        root.show-palette = true;
        root.palette-sel = 0;
        root.palette-query(palette-input.text);
        palette-input.focus();
        palette-input.select-all();
    }
    public function open-server-switcher() {
        root.show-server-switcher = true;
        root.switcher-sel = 0;
        switcher-input.text = "";
        root.switcher-opened();
        root.switcher-query("");
        switcher-input.focus();
    }

    public function set-radio-filter(value: string) {
        root.radio-filter = value;
        root.radio-filter-changed(value);
    }

    public function clear-radio-filter() {
        if (root.radio-filter != "") {
            root.set-radio-filter("");
        }
    }

    /// Open the playlist form. An empty id creates; anything else edits.
    ///
    /// Also clears the smart-playlist fields, so the form never opens carrying
    /// the rule from whatever was edited last.
    public function open-playlist-form(id: string, name: string, desc: string) {
        root.pl-form-id = id;
        root.pl-form-name = name;
        root.pl-form-desc = desc;
        root.pl-form-smart = false;
        root.pl-form-rsql = "";
        root.pl-form-sort-by = "";
        root.pl-form-sort-order = "asc";
        root.pl-form-limit = "";
        root.pl-form-preview-count = -1;
        root.pl-form-preview-error = "";
        root.pl-form-previewing = false;
        root.show-playlist-form = true;
    }

    /// Ask the daemon what the current filter would match. Cheap enough to run
    /// as the user types — it counts ids, it does not build the playlist.
    public function refresh-smart-preview() {
        root.pl-form-previewing = true;
        root.smart-playlist-preview(root.pl-form-rsql, root.pl-form-sort-by, root.pl-form-limit);
    }

    public function open-add-station() {
        root.add-station-name = "";
        root.add-station-url = "";
        root.add-station-genre = "";
        root.add-station-country = "";
        root.add-station-logo = "";
        root.add-station-status = "";
        root.add-station-ok = false;
        root.add-station-checking = false;
        root.add-station-saving = false;
        root.show-add-station = true;
    }

    // Also the way Rust dismisses the form once the station is stored.
    public function close-add-station() {
        root.show-add-station = false;
        root.add-station-saving = false;
    }

    public function submit-add-station() {
        if (root.add-station-name == "" || root.add-station-url == "" || root.add-station-saving) {
            return;
        }
        root.add-station-saving = true;
        root.add-station-status = "";
        root.radio-add-station(
            root.add-station-name,
            root.add-station-url,
            root.add-station-genre,
            root.add-station-country,
            root.add-station-logo);
    }

    public function open-radio-category(label: string, term: string) {
        root.radio-category = label;
        root.radios = [];
        root.radio-loading = true;
        root.clear-radio-filter();
        root.radio-browse(term);
    }
    function activate-switcher() {
        if (root.switcher-results.length > 0) {
            root.switcher-activate(root.switcher-results[clamp(root.switcher-sel, 0, root.switcher-results.length - 1)]);
            root.show-server-switcher = false;
            main-focus.focus();
        }
    }
    public function open-playlist-picker(track-id: string) {
        root.plpicker-track-id = track-id;
        root.show-playlist-picker = true;
        root.plpicker-sel = 0;
        plpicker-input.text = "";
        root.plpicker-query("");
        plpicker-input.focus();
    }
    function activate-plpicker() {
        if (root.plpicker-results.length > 0) {
            root.track-add-to-playlist(
                root.plpicker-results[clamp(root.plpicker-sel, 0, root.plpicker-results.length - 1)].id,
                root.plpicker-track-id);
            root.show-playlist-picker = false;
            main-focus.focus();
        }
    }
    public function open-track-picker() {
        root.show-track-picker = true;
        picker-input.text = "";
        root.picker-query("");
        picker-input.focus();
    }
    public function open-palette-with(q: string) {
        palette-input.text = q;
        root.open-palette();
    }
    function close-palette() {
        root.show-palette = false;
        main-focus.focus();
    }
    function activate-palette() {
        if (root.palette-results.length > 0) {
            root.palette-activate(root.palette-results[clamp(root.palette-sel, 0, root.palette-results.length - 1)]);
            root.close-palette();
        }
    }

    main-focus := FocusScope {
        width: 0;
        height: 0;
        key-released(event) => {
            if (event.text == "/") {
                root.open-palette();
                return accept;
            }
            if (event.text == "r") {
                root.current-tab = 6;
                root.radio-tab = 0;
                root.radio-category = "";
                root.show-radio-search = true;
                radio-input.focus();
                return accept;
            }
            if (event.text == "?") {
                root.show-help = true;
                return accept;
            }
            // Where the library is read from.
            if (event.text == "C") {
                root.open-server-switcher();
                return accept;
            }
            // Straight to the add-server form, for a server not saved yet.
            if (event.text == "A") {
                root.current-tab = 4;
                root.show-detail = false;
                root.show-artist = false;
                root.server-error = "";
                root.show-server-form = true;
                return accept;
            }
            reject
        }
        key-pressed(event) => {
            // '/', 'r' and '?' are handled on release (so the keystroke cannot
            // leak into the palette input) — swallow their press here.
            if (event.text == "/" || event.text == "r" || event.text == "?"
                || event.text == "C" || event.text == "A") {
                return accept;
            }
            if (event.text == " ") {
                root.play-pause();
                return accept;
            }
            if (event.text == "e") {
                root.show-audio = !root.show-audio;
                return accept;
            }
            if (event.text == "s") {
                root.cycle-skin();
                return accept;
            }
            if (event.text == "q") {
                root.show-queue = !root.show-queue;
                return accept;
            }
            if (event.text == "b") {
                root.show-sidebar = !root.show-sidebar;
                return accept;
            }
            // `=` and `_` are the unshifted faces of `+` and `-` on most
            // layouts, so both reach the same place.
            if (event.text == "+" || event.text == "=") {
                root.bump-volume(0.05);
                return accept;
            }
            if (event.text == "-" || event.text == "_") {
                root.bump-volume(-0.05);
                return accept;
            }
            if (event.text == "m") {
                root.toggle-mute();
                return accept;
            }
            if (event.text == "v") {
                root.show-equalizer = !root.show-equalizer;
                return accept;
            }
            if (event.text == "f") {
                // The full player is a canvas for the current track's art and
                // title; with nothing playing there is nothing to show, so the
                // key does nothing rather than opening an empty one.
                if (!root.stopped && root.now-title != "") {
                    root.show-full-player = !root.show-full-player;
                }
                return accept;
            }
            if (event.text == "n") {
                // New playlist, from anywhere. Lands on the playlists tab so
                // the result is visible once it is created.
                root.current-tab = 5;
                root.show-detail = false; root.show-artist = false;
                root.open-playlist-form("", "", "");
                return accept;
            }
            if (event.text == Key.Escape) {
                if (root.show-signin) {
                    root.show-signin = false;
                    main-focus.focus();
                } else if (root.show-renderers) {
                    root.show-renderers = false;
                    main-focus.focus();
                } else if (root.show-radio-search) {
                    root.show-radio-search = false;
                    main-focus.focus();
                } else if (root.show-full-player) {
                    root.show-full-player = false;
                } else if (root.show-confirm-delete) {
                    root.show-confirm-delete = false;
                } else if (root.show-playlist-picker) {
                    root.show-playlist-picker = false;
                    main-focus.focus();
                } else if (root.show-server-switcher) {
                    root.show-server-switcher = false;
                    main-focus.focus();
                } else if (root.show-server-form) {
                    root.show-server-form = false;
                } else if (root.show-add-station) {
                    root.close-add-station();
                    main-focus.focus();
                } else if (root.show-track-picker) {
                    root.show-track-picker = false;
                    main-focus.focus();
                } else if (root.show-playlist-form) {
                    root.show-playlist-form = false;
                } else if (root.show-help) {
                    root.show-help = false;
                } else if (root.show-audio) {
                    root.show-audio = false;
                } else if (root.show-queue) {
                    root.show-queue = false;
                } else if (root.show-detail) {
                    root.show-detail = false;
                } else if (root.show-artist) {
                    root.show-artist = false;
                } else if (root.pl-detail-open && root.current-tab == 5) {
                    root.pl-detail-open = false;
                }
                return accept;
            }
            reject
        }
    }

    HorizontalLayout {
        width: 100%;
        height: 100%;
        // ── Sidebar ─────────────────────────────────────────────────────────
        sidebar := Rectangle {
            width: root.show-sidebar && !root.show-full-player ? 208px : 0px;
            background: Theme.sidebar-bg;
            clip: true;
            animate width { duration: 160ms; easing: ease-out; }

            VerticalLayout {
                width: 208px;
                x: 0;
                padding: 12px;
                spacing: 4px;

                HorizontalLayout {
                    padding-left: 16px;
                    padding-top: 10px + root.titlebar-inset;
                    padding-bottom: 22px;
                    spacing: 8px;
                    Image {
                        source: Icons.disc;
                        colorize: Theme.accent;
                        width: 18px;
                        height: 18px;
                        y: (parent.height - self.height) / 2;
                    }
                    Text {
                        // Sized to fit the 208px sidebar on one line in Roboto
                        // Mono, which is wider per character than the face this
                        // started in.
                        text: "MUSIC PLAYER";
                        color: Theme.text;
                        font-size: 13px;
                        font-weight: 700;
                        letter-spacing: 1.5px;
                        wrap: no-wrap;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }

                SidebarItem {
                    icon: Icons.disc;
                    label: "Albums";
                    active: root.current-tab == 0;
                    clicked => { root.current-tab = 0; root.show-detail = false; root.show-artist = false; }
                }
                SidebarItem {
                    icon: Icons.artist;
                    label: "Artists";
                    active: root.current-tab == 1;
                    clicked => { root.current-tab = 1; root.show-detail = false; root.show-artist = false; }
                }
                SidebarItem {
                    icon: Icons.list-music;
                    label: "Tracks";
                    active: root.current-tab == 2;
                    clicked => { root.current-tab = 2; root.show-detail = false; root.show-artist = false; }
                }
                SidebarItem {
                    icon: Icons.heart;
                    label: "Liked";
                    active: root.current-tab == 3;
                    clicked => { root.current-tab = 3; root.show-detail = false; root.show-artist = false; }
                }
                SidebarItem {
                    icon: Icons.playlist;
                    label: "Playlists";
                    active: root.current-tab == 5;
                    clicked => { root.current-tab = 5; root.show-detail = false; root.show-artist = false; }
                }
                SidebarItem {
                    icon: Icons.broadcast;
                    label: "Internet Radio";
                    active: root.current-tab == 6;
                    clicked => { root.current-tab = 6; root.show-detail = false; root.show-artist = false; root.radio-tab = 0; root.radio-category = ""; }
                }
                SidebarItem {
                    icon: Icons.server;
                    label: "Servers";
                    active: root.current-tab == 4;
                    clicked => {
                        root.current-tab = 4;
                        root.show-detail = false;
                        root.show-artist = false;
                        // Another client may have added one since this list
                        // was last read; the daemon is the one that knows.
                        root.servers-refresh();
                    }
                }
                SidebarItem {
                    icon: Icons.extension;
                    label: "Extensions";
                    active: root.current-tab == 7;
                    clicked => {
                        root.current-tab = 7;
                        root.show-detail = false; root.show-artist = false;
                        root.extensions-loading = true;
                        root.extensions-refresh();
                    }
                }

                Rectangle { vertical-stretch: 1; }

                // Skin switcher
                skin-row := Rectangle {
                    visible: !root.show-full-player;
                    height: 52px;
                    border-radius: Theme.control-radius;
                    background: skin-touch.has-hover ? Theme.hover-bg : transparent;
                    VerticalLayout {
                        padding-left: 16px;
                        padding-top: 8px;
                        spacing: 2px;
                        Text {
                            text: "SKIN";
                            color: Theme.text-muted;
                            font-size: 9px;
                            letter-spacing: 1.5px;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Image {
                                source: Icons.settings;
                                colorize: Theme.accent;
                                width: 13px;
                                height: 13px;
                                y: (parent.height - self.height) / 2;
                            }
                            Text {
                                text: root.skin-name;
                                color: Theme.text-dim;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }
                    }
                    skin-touch := TouchArea {
                        clicked => { root.cycle-skin(); }
                        mouse-cursor: pointer;
                    }
                }
                Rectangle { height: 6px; }

                status-row := Rectangle {
                    visible: !root.show-full-player;
                    height: 30px;
                    border-radius: Theme.control-radius;
                    background: status-touch.has-hover ? Theme.hover-bg : transparent;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 8px;
                        spacing: 8px;
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 4px;
                            background: root.connected || root.provider-url != ""
                                ? Theme.meter-low : Theme.meter-high;
                        }
                        Text {
                            // The provider when there is one, else the daemon
                            // this client is talking to.
                            text: root.provider-url != "" ? root.provider-url : root.status-text;
                            color: status-touch.has-hover ? Theme.text-dim : Theme.text-muted;
                            font-size: 10px;
                            font-family: Theme.font-mono;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }
                    status-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.open-server-switcher(); }
                    }
                }

                // The account, below the daemon row: that one is about what
                // this client is connected to, this one about who you are.
                Rectangle {
                    visible: !root.show-full-player;
                    height: 1px;
                    background: Theme.border;
                }
                account-row := Rectangle {
                    visible: !root.show-full-player;
                    height: 44px;
                    border-radius: Theme.control-radius;
                    background: account-touch.has-hover ? Theme.hover-bg : transparent;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 10px;
                        spacing: 10px;

                        if root.account-handle == "" : Image {
                            source: Icons.user-circle;
                            colorize: Theme.text-dim;
                            width: 18px;
                            height: 18px;
                            y: (parent.height - self.height) / 2;
                        }
                        if root.account-handle != "" && root.account-has-avatar : Image {
                            source: root.account-avatar;
                            width: 26px;
                            height: 26px;
                            y: (parent.height - self.height) / 2;
                        }
                        // Initials stand in: plenty of accounts have no avatar.
                        if root.account-handle != "" && !root.account-has-avatar : Rectangle {
                            width: 26px;
                            height: 26px;
                            border-radius: 13px;
                            background: Theme.panel-bg;
                            y: (parent.height - self.height) / 2;
                            Text {
                                text: root.account-name != ""
                                    ? root.account-name.to-uppercase()
                                    : root.account-handle.to-uppercase();
                                color: Theme.text-dim;
                                font-size: 10px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                overflow: clip;
                            }
                        }

                        if root.account-handle == "" : Text {
                            text: "Sign in";
                            color: Theme.text-dim;
                            font-size: 12px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        if root.account-handle != "" : VerticalLayout {
                            alignment: center;
                            spacing: 1px;
                            horizontal-stretch: 1;
                            Text {
                                text: root.account-name != ""
                                    ? root.account-name : root.account-handle;
                                color: Theme.text;
                                font-size: 12px;
                                font-weight: 600;
                                overflow: elide;
                            }
                            // Muted: the name above is what the eye lands on.
                            Text {
                                text: "@" + root.account-handle;
                                color: Theme.text-muted;
                                font-size: 11px;
                                overflow: elide;
                            }
                        }
                    }

                    account-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            if (root.account-handle == "") {
                                root.signin-error = "";
                                root.show-signin = true;
                            } else {
                                // A menu, not an immediate sign-out. Clicking
                                // your own name should not end the session —
                                // and signing out here also stops scrobbling
                                // and station sync, which is not something to
                                // do on a stray click with no way to see it
                                // happened.
                                account-menu.show();
                            }
                        }
                        account-menu := PopupWindow {
                            x: 8px;
                            y: -46px;
                            width: 180px;
                            Rectangle {
                                background: Theme.panel-raised;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: Theme.border;
                                drop-shadow-color: #000000aa;
                                drop-shadow-blur: 18px;
                                VerticalLayout {
                                    padding: 4px;
                                    CtxMenuItem {
                                        icon: Icons.logout;
                                        label: "Sign out";
                                        clicked => { root.sign-out(); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ── Main column ─────────────────────────────────────────────────────
        VerticalLayout {
            // Header
            Rectangle {
                height: 62px;
                background: Theme.window-bg;
                HorizontalLayout {
                    padding-left: !root.show-sidebar && root.titlebar-inset > 0px ? 84px : 24px;
                    padding-right: 16px;
                    spacing: 12px;
                    Text {
                        text: root.show-detail ? "Album"
                            : root.show-artist ? "Artist"
                            : root.current-tab == 0 ? "Albums"
                            : root.current-tab == 1 ? "Artists"
                            : root.current-tab == 2 ? "Tracks"
                            : root.current-tab == 3 ? "Liked tracks"
                            : root.current-tab == 5 ? (root.pl-detail-open ? "Playlist" : "Playlists")
                            : root.current-tab == 6 ? "Internet Radio"
                            : root.current-tab == 7 ? "Extensions"
                            : "Servers";
                        color: Theme.text;
                        font-size: 20px;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    // Play / shuffle the whole liked list, next to its title.
                    if root.current-tab == 3 && !root.show-detail && root.liked.length > 0 : HorizontalLayout {
                        spacing: 8px;
                        IconButton {
                            icon: Icons.shuffle;
                            icon-size: 16px;
                            width: 38px;
                            height: 38px;
                            y: (parent.height - self.height) / 2;
                            clicked => { root.play-liked-shuffled(); }
                        }
                        IconButton {
                            icon: Icons.play;
                            icon-size: 16px;
                            width: 38px;
                            height: 38px;
                            y: (parent.height - self.height) / 2;
                            clicked => { root.play-liked(); }
                        }
                    }
                    SearchButton {
                        y: (parent.height - self.height) / 2;
                        clicked => { root.open-palette(); }
                    }
                    HorizontalLayout {
                        spacing: 2px;
                        IconButton {
                            icon: root.show-sidebar ? Icons.panel-left-filled : Icons.panel-left;
                            icon-size: 16px;
                            accented: root.show-sidebar;
                            y: (parent.height - self.height) / 2;
                            clicked => { root.show-sidebar = !root.show-sidebar; }
                        }
                        IconButton {
                            icon: root.show-queue ? Icons.panel-right-filled : Icons.panel-right;
                            icon-size: 16px;
                            accented: root.show-queue;
                            y: (parent.height - self.height) / 2;
                            clicked => { root.show-queue = !root.show-queue; }
                        }
                    }
                }
            }

            // Content
            content := Rectangle {
                background: Theme.window-bg;
                vertical-stretch: 1;

                // Albums grid — placeholders while the first fetch is out.
                if root.current-tab == 0 && root.library-loading : Rectangle {
                    property <float> cols: max(2, floor((self.width - 48px) / 196px));
                    property <length> gap: 16px;
                    property <length> cell-w: (self.width - 48px - self.gap * (self.cols - 1)) / self.cols;
                    x: 24px;
                    width: parent.width - 48px;
                    for i in 12 : AlbumSkeletonCard {
                        x: mod(i, parent.cols) * (parent.cell-w + parent.gap);
                        y: floor(i / parent.cols) * (parent.cell-w + 66px + parent.gap);
                        width: parent.cell-w;
                        height: parent.cell-w + 66px;
                    }
                }
                if root.current-tab == 0 && !root.library-loading : Flickable {
                    property <float> cols: max(2, floor((self.width - 48px) / 196px));
                    property <length> gap: 16px;
                    property <length> cell-w: (self.width - 48px - self.gap * (self.cols - 1)) / self.cols;
                    property <length> cell-h: self.cell-w + 66px;
                    x: 24px;
                    width: parent.width - 48px;
                    viewport-height: ceil(root.albums.length / self.cols) * (self.cell-h + self.gap) + 90px;

                    for a[i] in root.albums : AlbumCard {
                        album: a;
                        x: mod(i, parent.cols) * (parent.cell-w + parent.gap);
                        y: floor(i / parent.cols) * (parent.cell-h + parent.gap);
                        width: parent.cell-w;
                        height: parent.cell-h;
                        play => { root.play-album(a.id); }
                        open => {
                            // Navigate first: fetching the tracks is a round
                            // trip, and waiting on it makes the click feel
                            // dropped. The card already has everything the
                            // header needs.
                            root.detail-album = a;
                            root.detail-meta = "";
                            root.detail-label = "";
                            root.detail-tracks = [];
                            root.detail-loading = true;
                            root.show-detail = true;
                            root.open-album(a.id);
                        }
                        shuffle-play => { root.play-album-shuffled(a.id); }
                        play-next => { root.album-insert(a.id, -2); }
                        add-queue => { root.album-insert(a.id, -3); }
                        like => { root.album-like(a.id); }
                    }
                }

                // Artists
                if root.current-tab == 1 && root.library-loading : ArtistSkeletonList {
                    x: 24px;
                    width: parent.width - 48px;
                }
                if root.current-tab == 1 && !root.library-loading : ListView {
                    x: 24px;
                    width: parent.width - 48px;
                    for a[i] in root.artists : ArtistRow {
                        artist: a;
                        play => { root.play-artist(a.id); }
                        open => { root.open-artist(a.id); }
                    }
                }

                // All tracks
                if root.current-tab == 2 && root.library-loading : VerticalLayout {
                    x: 24px;
                    width: parent.width - 48px;
                    TrackListHeader {
                            show-analysis: root.provider-analyses;}
                    TrackSkeletonList { rows: 12; }
                }
                if root.current-tab == 2 && !root.library-loading : VerticalLayout {
                    x: 24px;
                    width: parent.width - 48px;
                    TrackListHeader {
                            show-analysis: root.provider-analyses;}
                    ListView {
                        for t[i] in root.tracks : TrackRow {
                            show-analysis: root.provider-analyses;
                            track: t;
                            current: !root.stopped && t.title == root.now-title && t.artist == root.now-artist;
                            play => { root.play-track-at(t.index); }
                            playlists: root.playlists;
                            like-toggled => { root.track-like(t.id); }
                            play-next => { root.track-insert(t.id, -2); }
                            add-queue => { root.track-insert(t.id, -3); }
                            go-album => { root.open-album(t.album-id); }
                            add-to-playlist(plid) => { root.track-add-to-playlist(plid, t.id); }
                            browse-playlists => { root.open-playlist-picker(t.id); }
                        }
                    }
                }

                // Liked tracks
                if root.current-tab == 3 && root.library-loading : VerticalLayout {
                    x: 24px;
                    width: parent.width - 48px;
                    TrackListHeader {
                            show-analysis: root.provider-analyses;}
                    TrackSkeletonList { rows: 10; }
                }
                if root.current-tab == 3 && !root.library-loading : VerticalLayout {
                    x: 24px;
                    width: parent.width - 48px;
                    TrackListHeader {
                            show-analysis: root.provider-analyses;}
                    ListView {
                        for t[i] in root.liked : TrackRow {
                            show-analysis: root.provider-analyses;
                            track: t;
                            current: !root.stopped && t.title == root.now-title && t.artist == root.now-artist;
                            play => { root.play-liked-at(t.index); }
                            playlists: root.playlists;
                            like-toggled => { root.track-like(t.id); }
                            play-next => { root.track-insert(t.id, -2); }
                            add-queue => { root.track-insert(t.id, -3); }
                            go-album => { root.open-album(t.album-id); }
                            add-to-playlist(plid) => { root.track-add-to-playlist(plid, t.id); }
                            browse-playlists => { root.open-playlist-picker(t.id); }
                        }
                    }
                }

                // ── Playlists ───────────────────────────────────────────────
                if root.current-tab == 5 && !root.pl-detail-open && root.library-loading
                    : PlaylistSkeletonList {
                    x: 24px;
                    width: parent.width - 48px;
                }
                if root.current-tab == 5 && !root.pl-detail-open && !root.library-loading
                    : VerticalLayout {
                    x: 24px;
                    width: parent.width - 48px;
                    spacing: 8px;

                    HorizontalLayout {
                        height: 44px;
                        new-pl-btn := Rectangle {
                            width: 140px;
                            height: 34px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 17px;
                            background: newpl-touch.has-hover ? Theme.accent-hover : Theme.accent;
                            HorizontalLayout {
                                alignment: center;
                                spacing: 6px;
                                Image {
                                    source: Icons.circle-plus;
                                    colorize: Theme.on-accent;
                                    width: 14px;
                                    height: 14px;
                                    y: (parent.height - self.height) / 2;
                                }
                                Text {
                                    text: "New playlist";
                                    color: Theme.on-accent;
                                    font-size: 12px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }
                            newpl-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.open-playlist-form("", "", "");
                                }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    ListView {
                        vertical-stretch: 1;
                        for pl[i] in root.playlists : Rectangle {
                            height: 62px;
                            PlaylistRow {
                                width: 100%;
                                height: 56px;
                                playlist: pl;
                                open => {
                                    // Navigate first, as the album grid does:
                                    // fetching the tracks is a round trip.
                                    root.pl-detail = pl;
                                    root.pl-detail-tracks = [];
                                    root.pl-detail-loading = true;
                                    root.pl-detail-open = true;
                                    root.playlists-open(pl.id);
                                }
                                play => { root.playlist-play(pl.id); }
                                shuffle-play => { root.playlist-shuffle(pl.id); }
                                edit => {
                                    root.open-playlist-form(pl.id, pl.name, pl.description);
                                }
                                delete => {
                                    root.confirm-delete-id = pl.id;
                                    root.confirm-delete-name = pl.name;
                                    root.show-confirm-delete = true;
                                }
                            }
                        }
                    }
                    if root.playlists.length == 0 : Text {
                        text: "No playlists yet — create one!";
                        color: Theme.text-muted;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-stretch: 1;
                        vertical-alignment: center;
                    }
                }

                // Playlist detail
                if root.current-tab == 5 && root.pl-detail-open : VerticalLayout {
                    x: 24px;
                    width: parent.width - 48px;
                    spacing: 6px;

                    HorizontalLayout {
                        spacing: 10px;
                        height: 52px;
                        IconButton {
                            icon: Icons.chevron-left;
                            icon-size: 17px;
                            y: (parent.height - self.height) / 2;
                            clicked => { root.pl-detail-open = false; }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            horizontal-stretch: 1;
                            Text {
                                text: root.pl-detail.name;
                                color: Theme.text;
                                font-size: 16px;
                                font-weight: 700;
                                overflow: elide;
                            }
                            Text {
                                text: root.pl-detail.description == ""
                                    ? (root.pl-detail.count == 1 ? "1 track" : root.pl-detail.count + " tracks")
                                    : root.pl-detail.description + " · "
                                        + (root.pl-detail.count == 1 ? "1 track" : root.pl-detail.count + " tracks");
                                color: Theme.text-dim;
                                font-size: 11px;
                                overflow: elide;
                            }
                        }
                        IconButton {
                            icon: Icons.circle-plus;
                            icon-size: 17px;
                            y: (parent.height - self.height) / 2;
                            clicked => { root.open-track-picker(); }
                        }
                        IconButton {
                            icon: Icons.pencil;
                            icon-size: 15px;
                            y: (parent.height - self.height) / 2;
                            clicked => {
                                root.open-playlist-form(
                                    root.pl-detail.id,
                                    root.pl-detail.name,
                                    root.pl-detail.description);
                            }
                        }
                        // Beside play, as the album detail has it.
                        IconButton {
                            icon: Icons.shuffle;
                            icon-size: 17px;
                            y: (parent.height - self.height) / 2;
                            clicked => { root.playlist-shuffle(root.pl-detail.id); }
                        }
                        PlayPauseButton {
                            playing: false;
                            y: (parent.height - self.height) / 2;
                            clicked => { root.playlist-play(root.pl-detail.id); }
                        }
                    }
                    TrackListHeader {
                            show-analysis: root.provider-analyses;}
                    if root.pl-detail-loading : TrackSkeletonList {
                        rows: 8;
                        vertical-stretch: 1;
                    }
                    if !root.pl-detail-loading : ListView {
                        vertical-stretch: 1;
                        for t[i] in root.pl-detail-tracks : Rectangle {
                            height: 42px;
                            TrackRow {
                            show-analysis: root.provider-analyses;
                                width: 100%;
                                height: 42px;
                                track: t;
                                current: !root.stopped && t.title == root.now-title && t.artist == root.now-artist;
                                play => { root.playlist-play(root.pl-detail.id); }
                            playlists: root.playlists;
                            like-toggled => { root.track-like(t.id); }
                            play-next => { root.track-insert(t.id, -2); }
                            add-queue => { root.track-insert(t.id, -3); }
                            go-album => { root.open-album(t.album-id); }
                            add-to-playlist(plid) => { root.track-add-to-playlist(plid, t.id); }
                            browse-playlists => { root.open-playlist-picker(t.id); }
                            }
                            IconButton {
                                icon: Icons.trash;
                                icon-size: 13px;
                                width: 26px;
                                height: 26px;
                                x: parent.width - self.width - 64px;
                                y: (parent.height - self.height) / 2;
                                clicked => { root.playlist-remove-track(t.id); }
                            }
                        }
                    }
                    if !root.pl-detail-loading && root.pl-detail-tracks.length == 0 : Text {
                        text: "Empty playlist — click + to add tracks.";
                        color: Theme.text-muted;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-stretch: 1;
                        vertical-alignment: center;
                    }
                }

                // ── Servers (Subsonic / Jellyfin) ───────────────────────────
                if root.current-tab == 4 : Flickable {
                    x: 24px;
                    width: parent.width - 48px;
                    viewport-height: servers-content.preferred-height + 40px;

                    servers-content := VerticalLayout {
                        width: parent.width;
                        spacing: 8px;

                        // Above the list, not below it: with a screen's worth
                        // of servers the button would be off the bottom, and
                        // adding one is the reason to come here with none.
                        HorizontalLayout {
                            padding-bottom: 2px;
                            add-srv-btn := Rectangle {
                                width: 130px;
                                height: 34px;
                                border-radius: 17px;
                                background: addsrv-touch.has-hover ? Theme.accent-hover : Theme.accent;
                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 6px;
                                    Image {
                                        source: Icons.circle-plus;
                                        colorize: Theme.on-accent;
                                        width: 14px;
                                        height: 14px;
                                        y: (parent.height - self.height) / 2;
                                    }
                                    Text {
                                        text: "Add server";
                                        color: Theme.on-accent;
                                        font-size: 12px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }
                                addsrv-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.show-server-form = true; }
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }

                        for srv[i] in root.servers : ServerRow {
                            server: srv;
                            connect => {
                                root.server-error = "";
                                root.server-connect(i);
                            }
                            disconnect => { root.server-disconnect(); }
                            delete => { root.server-delete(i); }
                        }
                        if root.servers.length == 0 : Text {
                            text: "No servers yet — add a Subsonic/Navidrome or Jellyfin server above.";
                            color: Theme.text-muted;
                            font-size: 12px;
                        }
                        if root.server-error != "" : Text {
                            text: root.server-error;
                            color: Theme.meter-high;
                            font-size: 12px;
                        }
                    }
                }

                if root.current-tab == 6 : VerticalLayout {
                    x: 24px;
                    width: parent.width - 48px;
                    spacing: 12px;
                    HorizontalLayout {
                        height: 38px;
                        spacing: 8px;
                        for label[i] in ["Search", "Bookmarked", "Stations"] : Rectangle {
                            width: 112px;
                            background: tab-touch.has-hover ? Theme.hover-bg : transparent;
                            Text { text: label; color: root.radio-tab == i ? Theme.accent : Theme.text-dim; horizontal-alignment: center; vertical-alignment: center; font-size: 12px; font-weight: 600; }
                            Rectangle { y: parent.height - 2px; height: 2px; width: parent.width; background: root.radio-tab == i ? Theme.accent : transparent; }
                            tab-touch := TouchArea {
                                clicked => {
                                    root.radio-tab = i;
                                    root.radio-category = "";
                                    root.clear-radio-filter();
                                    if (i != 0) {
                                        root.radios = [];
                                        root.radio-loading = true;
                                    }
                                    if (i == 1) {
                                        root.radio-bookmarks();
                                    }
                                    if (i == 2) {
                                        root.radio-stations();
                                    }
                                }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        if root.radio-tab == 2 : IconButton {
                            icon: Icons.circle-plus;
                            icon-size: 17px;
                            y: (parent.height - self.height) / 2;
                            clicked => { root.open-add-station(); }
                        }
                        // Quick filter over the station list on screen.
                        if root.radio-tab != 0 : RadioFilterBox {
                            width: 190px;
                            y: (parent.height - self.height) / 2;
                            text: root.radio-filter;
                            edited(value) => { root.set-radio-filter(value); }
                        }
                    }
                    if root.radio-tab == 0 && root.radio-category == "" : Rectangle {
                        height: 44px;
                        background: transparent;
                        Rectangle { y: parent.height - 1px; height: 1px; width: parent.width; background: Theme.border; }
                        HorizontalLayout { padding-left: 4px; spacing: 10px; Image { source: Icons.search; colorize: Theme.text-muted; width: 19px; height: 19px; y: (parent.height - self.height) / 2; } Text { text: "Search radio stations…"; color: Theme.text-muted; font-size: 14px; vertical-alignment: center; } }
                        TouchArea { clicked => { root.show-radio-search = true; radio-input.focus(); } mouse-cursor: text; }
                    }
                    if root.radio-tab == 0 && root.radio-category == "" : Flickable {
                        vertical-stretch: 1;
                        viewport-height: category-grid.preferred-height + 12px;
                        category-grid := GridLayout {
                            width: parent.width;
                            spacing: 8px;
                            Row { RadioCategoryTile { label:"Synthwave"; term:"synthwave"; icon:Icons.equalizer; icon-color:#ff4fa3; selected(l,t)=>{root.open-radio-category(l,t);} } RadioCategoryTile { label:"Lo-fi"; term:"lofi"; icon:Icons.volume; icon-color:#39d9e8; selected(l,t)=>{root.open-radio-category(l,t);} } RadioCategoryTile { label:"Jazz"; term:"jazz"; icon:Icons.music; icon-color:#f2c94c; selected(l,t)=>{root.open-radio-category(l,t);} } RadioCategoryTile { label:"Techno"; term:"techno"; icon:Icons.volume; icon-color:#9b6cff; selected(l,t)=>{root.open-radio-category(l,t);} } }
                            Row { RadioCategoryTile { label:"Ambient"; term:"ambient"; icon:Icons.equalizer; icon-color:#39d9e8; selected(l,t)=>{root.open-radio-category(l,t);} } RadioCategoryTile { label:"Classical"; term:"classical"; icon:Icons.music; icon-color:#f052d4; selected(l,t)=>{root.open-radio-category(l,t);} } RadioCategoryTile { label:"Rock"; term:"rock"; icon:Icons.disc; icon-color:#ff4fa3; selected(l,t)=>{root.open-radio-category(l,t);} } RadioCategoryTile { label:"Pop"; term:"pop"; icon:Icons.artist; icon-color:#f052d4; selected(l,t)=>{root.open-radio-category(l,t);} } }
                            Row { RadioCategoryTile { label:"Electronic"; term:"electronic"; icon:Icons.disc; icon-color:#4d8dff; selected(l,t)=>{root.open-radio-category(l,t);} } RadioCategoryTile { label:"Hip-Hop"; term:"hip hop"; icon:Icons.disc; icon-color:#f2c94c; selected(l,t)=>{root.open-radio-category(l,t);} } RadioCategoryTile { label:"Chillout"; term:"chill"; icon:Icons.heart; icon-color:#39d9e8; selected(l,t)=>{root.open-radio-category(l,t);} } RadioCategoryTile { label:"Dance"; term:"dance"; icon:Icons.volume; icon-color:#ff4fa3; selected(l,t)=>{root.open-radio-category(l,t);} } }
                            Row { RadioCategoryTile { label:"Reggae"; term:"reggae"; icon:Icons.music; icon-color:#f2c94c; selected(l,t)=>{root.open-radio-category(l,t);} } RadioCategoryTile { label:"Metal"; term:"metal"; icon:Icons.disc; icon-color:#9b6cff; selected(l,t)=>{root.open-radio-category(l,t);} } RadioCategoryTile { label:"News"; term:"news"; icon:Icons.broadcast; icon-color:#39d9e8; selected(l,t)=>{root.open-radio-category(l,t);} } RadioCategoryTile { label:"World"; term:"world"; icon:Icons.broadcast; icon-color:#4d8dff; selected(l,t)=>{root.open-radio-category(l,t);} } }
                            Row { RadioCategoryTile { label:"House"; term:"house"; icon:Icons.volume; icon-color:#39d9e8; selected(l,t)=>{root.open-radio-category(l,t);} } RadioCategoryTile { label:"Trance"; term:"trance"; icon:Icons.equalizer; icon-color:#9b6cff; selected(l,t)=>{root.open-radio-category(l,t);} } RadioCategoryTile { label:"Drum & Bass"; term:"drum and bass"; icon:Icons.volume; icon-color:#4d8dff; selected(l,t)=>{root.open-radio-category(l,t);} } RadioCategoryTile { label:"Disco"; term:"disco"; icon:Icons.disc; icon-color:#ff4fa3; selected(l,t)=>{root.open-radio-category(l,t);} } }
                            Row { RadioCategoryTile { label:"Funk"; term:"funk"; icon:Icons.disc; icon-color:#f052d4; selected(l,t)=>{root.open-radio-category(l,t);} } RadioCategoryTile { label:"Soul"; term:"soul"; icon:Icons.music; icon-color:#ff4fa3; selected(l,t)=>{root.open-radio-category(l,t);} } RadioCategoryTile { label:"R&B"; term:"r&b"; icon:Icons.artist; icon-color:#9b6cff; selected(l,t)=>{root.open-radio-category(l,t);} } RadioCategoryTile { label:"Blues"; term:"blues"; icon:Icons.music; icon-color:#4d8dff; selected(l,t)=>{root.open-radio-category(l,t);} } }
                            Row { RadioCategoryTile { label:"Country"; term:"country"; icon:Icons.music; icon-color:#f2c94c; selected(l,t)=>{root.open-radio-category(l,t);} } RadioCategoryTile { label:"Folk"; term:"folk"; icon:Icons.music; icon-color:#39d9e8; selected(l,t)=>{root.open-radio-category(l,t);} } RadioCategoryTile { label:"Punk"; term:"punk"; icon:Icons.disc; icon-color:#ff4fa3; selected(l,t)=>{root.open-radio-category(l,t);} } RadioCategoryTile { label:"Indie"; term:"indie"; icon:Icons.volume; icon-color:#f052d4; selected(l,t)=>{root.open-radio-category(l,t);} } }
                            Row { RadioCategoryTile { label:"Latin"; term:"latin"; icon:Icons.music; icon-color:#f052d4; selected(l,t)=>{root.open-radio-category(l,t);} } RadioCategoryTile { label:"K-Pop"; term:"k-pop"; icon:Icons.artist; icon-color:#ff4fa3; selected(l,t)=>{root.open-radio-category(l,t);} } RadioCategoryTile { label:"Gospel"; term:"gospel"; icon:Icons.music; icon-color:#f2c94c; selected(l,t)=>{root.open-radio-category(l,t);} } RadioCategoryTile { label:"Oldies"; term:"oldies"; icon:Icons.disc; icon-color:#39d9e8; selected(l,t)=>{root.open-radio-category(l,t);} } }
                            Row { RadioCategoryTile { label:"Soundtrack"; term:"soundtrack"; icon:Icons.playlist; icon-color:#4d8dff; selected(l,t)=>{root.open-radio-category(l,t);} } Rectangle {} Rectangle {} Rectangle {} }
                        }
                    }
                    if root.radio-tab == 0 && root.radio-category != "" : VerticalLayout {
                        spacing: 8px;
                        HorizontalLayout {
                            height: 40px;
                            spacing: 8px;
                            IconButton {
                                icon: Icons.chevron-left;
                                icon-size: 17px;
                                clicked => { root.radio-category = ""; root.clear-radio-filter(); }
                            }
                            Text { text: root.radio-category; color: Theme.text; font-size: 16px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                            // Quick filter over the stations in this category.
                            RadioFilterBox {
                                width: 190px;
                                y: (parent.height - self.height) / 2;
                                text: root.radio-filter;
                                edited(value) => { root.set-radio-filter(value); }
                            }
                        }
                        if root.radio-loading : RadioSkeletonList { vertical-stretch: 1; }
                        if !root.radio-loading : ListView { vertical-stretch: 1;
                            for station in root.radios : RadioRow { station:station; play=>{root.radio-play(station.id);} bookmark=>{root.radio-bookmark(station.id);} }
                        }
                    }
                    if root.radio-tab != 0 && root.radio-loading : RadioSkeletonList {
                        vertical-stretch: 1;
                    }
                    if root.radio-tab != 0 && !root.radio-loading && root.radios.length > 0 : ListView {
                        vertical-stretch: 1;
                        for station in root.radios : RadioRow {
                            station: station;
                            play => { root.radio-play(station.id); }
                            bookmark => { root.radio-bookmark(station.id); }
                        }
                    }
                    if root.radio-tab != 0 && !root.radio-loading && root.radios.length == 0 : Text {
                        text: root.radio-tab == 2
                            ? "No station of your own yet. Add one with its stream url."
                            : "No bookmarked station yet.";
                        color: Theme.text-muted;
                        font-size: 13px;
                        vertical-stretch: 1;
                        horizontal-alignment: center;
                    }
                }

                // ── Extensions ─────────────────────────────────────────────
                if root.current-tab == 7 : VerticalLayout {
                    x: 24px;
                    width: parent.width - 48px;
                    spacing: 10px;

                    // One row: the state tabs at the left, the search and the
                    // rescan button pushed to the far right, so it reads as a
                    // single filter bar rather than two unrelated controls.
                    HorizontalLayout {
                        height: 34px;
                        spacing: 6px;
                        for label[i] in ["All", "Enabled", "Disabled"] : Rectangle {
                            width: 74px;
                            height: 26px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 13px;
                            background: root.extension-state-filter == i
                                ? Theme.selected-bg
                                : (chip-touch.has-hover ? Theme.hover-bg : transparent);
                            border-width: root.extension-state-filter == i ? 1px : 0px;
                            border-color: Theme.accent.with-alpha(0.4);
                            Text {
                                text: label;
                                color: root.extension-state-filter == i ? Theme.accent : Theme.text-dim;
                                font-size: 11px;
                                font-weight: root.extension-state-filter == i ? 600 : 400;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: parent.width;
                                height: parent.height;
                            }
                            chip-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.extension-state-filter = i;
                                    root.extension-filter-changed(root.extension-filter);
                                }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        RadioFilterBox {
                            width: 220px;
                            y: (parent.height - self.height) / 2;
                            placeholder: "Search extensions…";
                            text: root.extension-filter;
                            edited(value) => {
                                root.extension-filter = value;
                                root.extension-filter-changed(value);
                            }
                        }
                        IconButton {
                            icon: Icons.refresh;
                            icon-size: 15px;
                            y: (parent.height - self.height) / 2;
                            clicked => {
                                root.extensions-loading = true;
                                root.extensions-refresh();
                            }
                        }
                    }

                    if root.extensions-loading : RadioSkeletonList {
                        rows: 4;
                        vertical-stretch: 1;
                    }
                    if !root.extensions-loading && root.extensions.length > 0 : ListView {
                        vertical-stretch: 1;
                        for ext in root.extensions : Rectangle {
                            height: ext.error != "" ? 116px : 100px;
                            ExtensionRow {
                                width: 100%;
                                extension: ext;
                                toggled(enabled) => {
                                    root.extension-set-enabled(ext.id, enabled);
                                }
                            }
                        }
                    }
                    if !root.extensions-loading && root.extensions.length == 0 : Text {
                        text: root.extension-filter != "" || root.extension-state-filter != 0
                            ? "No extension matches that filter."
                            : "No extension installed. Create one with `music-player extension init <id>`.";
                        color: Theme.text-muted;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        vertical-stretch: 1;
                    }
                }

                // ── Artist detail ───────────────────────────────────────────
                if root.show-artist : Rectangle {
                    background: Theme.window-bg;
                    VerticalLayout {
                        padding-left: 24px;
                        padding-right: 24px;
                        spacing: 12px;

                        HorizontalLayout {
                            spacing: 20px;
                            padding-bottom: 8px;

                            IconButton {
                                icon: Icons.chevron-left;
                                icon-size: 18px;
                                y: 0;
                                clicked => { root.show-artist = false; }
                            }
                            // Round, like every other portrait in the client.
                            Rectangle {
                                width: 150px;
                                height: 150px;
                                border-radius: 75px;
                                background: Theme.art-placeholder;
                                clip: true;
                                if root.artist-detail.has-art : Image {
                                    width: parent.width;
                                    height: parent.height;
                                    source: root.artist-detail.art;
                                    image-fit: cover;
                                }
                                if !root.artist-detail.has-art : Image {
                                    source: Icons.artist;
                                    colorize: Theme.text-muted;
                                    width: parent.width * 0.4;
                                    height: self.width;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                            VerticalLayout {
                                alignment: end;
                                spacing: 6px;
                                horizontal-stretch: 1;
                                Text {
                                    text: "ARTIST";
                                    color: Theme.text-muted;
                                    font-size: 10px;
                                    letter-spacing: 1.5px;
                                }
                                Text {
                                    text: root.artist-detail.name;
                                    color: Theme.text;
                                    font-size: 26px;
                                    font-weight: 700;
                                    overflow: elide;
                                }
                                Text {
                                    text: root.artist-detail-meta;
                                    color: Theme.text-muted;
                                    font-size: 12px;
                                    overflow: elide;
                                }
                            }
                            VerticalLayout {
                                alignment: end;
                                HorizontalLayout {
                                    spacing: 10px;
                                    IconButton {
                                        icon: Icons.shuffle;
                                        icon-size: 18px;
                                        width: 44px;
                                        height: 44px;
                                        y: 0;
                                        clicked => { root.play-artist-shuffled(root.artist-detail.id); }
                                    }
                                    PlayPauseButton {
                                        playing: false;
                                        clicked => { root.play-artist(root.artist-detail.id); }
                                    }
                                }
                            }
                        }

                        // Albums, then songs, in one scroller so the grid does
                        // not fight the track list for the wheel.
                        Flickable {
                            vertical-stretch: 1;
                            viewport-height: artist-body.preferred-height + 30px;

                            artist-body := VerticalLayout {
                                width: parent.width;
                                spacing: 10px;

                                if root.artist-detail-albums.length > 0 : SectionHeader {
                                    title: "ALBUMS";
                                }
                                if root.artist-detail-albums.length > 0 : Rectangle {
                                    property <float> cols: max(2, floor(self.width / 196px));
                                    property <length> gap: 16px;
                                    property <length> cell-w: (self.width - self.gap * (self.cols - 1)) / self.cols;
                                    property <length> cell-h: self.cell-w + 66px;
                                    height: ceil(root.artist-detail-albums.length / self.cols) * (self.cell-h + self.gap);

                                    for a[i] in root.artist-detail-albums : AlbumCard {
                                        album: a;
                                        x: mod(i, parent.cols) * (parent.cell-w + parent.gap);
                                        y: floor(i / parent.cols) * (parent.cell-h + parent.gap);
                                        width: parent.cell-w;
                                        height: parent.cell-h;
                                        play => { root.play-album(a.id); }
                                        open => {
                                            root.detail-album = a;
                                            root.detail-meta = "";
                                            root.detail-label = "";
                                            root.detail-tracks = [];
                                            root.detail-loading = true;
                                            root.show-detail = true;
                                            root.open-album(a.id);
                                        }
                                        shuffle-play => { root.play-album-shuffled(a.id); }
                                        play-next => { root.album-insert(a.id, -2); }
                                        add-queue => { root.album-insert(a.id, -3); }
                                        like => { root.album-like(a.id); }
                                    }
                                }

                                if root.artist-detail-tracks.length > 0 : SectionHeader {
                                    title: "SONGS";
                                }
                                if root.artist-detail-tracks.length > 0 : TrackListHeader {
                            show-analysis: root.provider-analyses;}
                                for t[i] in root.artist-detail-tracks : TrackRow {
                            show-analysis: root.provider-analyses;
                                    track: t;
                                    height: 42px;
                                    current: !root.stopped && t.title == root.now-title && t.artist == root.now-artist;
                                    playlists: root.playlists;
                                    play => { root.play-artist-at(root.artist-detail.id, i); }
                                    like-toggled => { root.track-like(t.id); }
                                    play-next => { root.track-insert(t.id, -2); }
                                    add-queue => { root.track-insert(t.id, -3); }
                                    go-album => { root.open-album(t.album-id); }
                                    add-to-playlist(plid) => { root.track-add-to-playlist(plid, t.id); }
                                }
                            }
                        }
                    }
                }

                if root.show-detail : Rectangle {
                    background: Theme.window-bg;
                    VerticalLayout {
                        padding-left: 24px;
                        padding-right: 24px;
                        spacing: 12px;

                        HorizontalLayout {
                            spacing: 20px;
                            padding-bottom: 8px;

                            IconButton {
                                icon: Icons.chevron-left;
                                icon-size: 18px;
                                y: 0;
                                clicked => { root.show-detail = false; }
                            }
                            Rectangle {
                                width: 150px;
                                height: 150px;
                                background: Theme.art-placeholder;
                                clip: true;
                                if root.detail-album.has-art : Image {
                                    width: parent.width;
                                    height: parent.height;
                                    source: root.detail-album.art;
                                    image-fit: cover;
                                }
                                if !root.detail-album.has-art : Image {
                                    source: Icons.disc;
                                    colorize: Theme.text-muted;
                                    width: parent.width * 0.4;
                                    height: self.width;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                            VerticalLayout {
                                alignment: end;
                                spacing: 6px;
                                horizontal-stretch: 1;
                                Text {
                                    text: "ALBUM";
                                    color: Theme.text-muted;
                                    font-size: 10px;
                                    letter-spacing: 1.5px;
                                }
                                Text {
                                    text: root.detail-album.title;
                                    color: Theme.text;
                                    font-size: 26px;
                                    font-weight: 700;
                                    overflow: elide;
                                }
                                Text {
                                    text: root.detail-album.artist;
                                    color: Theme.text-dim;
                                    font-size: 14px;
                                    overflow: elide;
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    Text {
                                        text: root.detail-meta;
                                        color: Theme.text-muted;
                                        font-size: 12px;
                                        overflow: elide;
                                    }
                                    if root.detail-label != "" : Text {
                                        text: "· " + root.detail-label;
                                        color: Theme.text-muted;
                                        font-size: 12px;
                                        overflow: elide;
                                    }
                                }
                            }
                            VerticalLayout {
                                alignment: end;
                                HorizontalLayout {
                                    spacing: 10px;
                                    IconButton {
                                        icon: Icons.shuffle;
                                        icon-size: 18px;
                                        width: 44px;
                                        height: 44px;
                                        y: 0;
                                        clicked => { root.play-album-shuffled(root.detail-album.id); }
                                    }
                                    PlayPauseButton {
                                        playing: false;
                                        clicked => { root.play-album(root.detail-album.id); }
                                    }
                                    detail-menu-btn := IconButton {
                                        icon: Icons.ellipsis;
                                        icon-size: 18px;
                                        width: 44px;
                                        height: 44px;
                                        clicked => { detail-menu.show(); }
                                        detail-menu := PopupWindow {
                                            x: -150px;
                                            y: 48px;
                                            width: 190px;
                                            Rectangle {
                                                background: Theme.panel-raised;
                                                border-radius: 10px;
                                                border-width: 1px;
                                                border-color: Theme.border;
                                                drop-shadow-color: #000000aa;
                                                drop-shadow-blur: 18px;
                                                VerticalLayout {
                                                    padding: 4px;
                                                    CtxMenuItem {
                                                        icon: Icons.shuffle;
                                                        label: "Shuffle play";
                                                        clicked => { root.play-album-shuffled(root.detail-album.id); }
                                                    }
                                                    CtxMenuItem {
                                                        icon: Icons.next;
                                                        label: "Play next";
                                                        clicked => { root.album-insert(root.detail-album.id, -2); }
                                                    }
                                                    CtxMenuItem {
                                                        icon: Icons.list-music;
                                                        label: "Add to queue";
                                                        clicked => { root.album-insert(root.detail-album.id, -3); }
                                                    }
                                                    Rectangle { height: 1px; background: Theme.border; }
                                                    CtxMenuItem {
                                                        icon: Icons.heart;
                                                        label: "Like album";
                                                        clicked => { root.album-like(root.detail-album.id); }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        TrackListHeader {
                            show-analysis: root.provider-analyses;}
                        if root.detail-loading : TrackSkeletonList {
                            rows: 8;
                            vertical-stretch: 1;
                        }
                        if !root.detail-loading : ListView {
                            vertical-stretch: 1;
                            for r[i] in root.detail-tracks : Rectangle {
                                height: r.is-header ? 36px : 42px;
                                // Both centered in one band. The icon used to
                                // carry a manual `y` measured from the row
                                // while the text was centered by the layout —
                                // and the layout's own top padding shifted the
                                // text but not the icon, so they never lined
                                // up.
                                if r.is-header : Rectangle {
                                    disc-line := HorizontalLayout {
                                        x: 12px;
                                        y: (parent.height - self.height) / 2;
                                        height: 16px;
                                        spacing: 8px;
                                        Image {
                                            source: Icons.disc;
                                            colorize: Theme.text-muted;
                                            width: 12px;
                                            height: 12px;
                                            y: (parent.height - self.height) / 2;
                                        }
                                        Text {
                                            text: r.header;
                                            color: Theme.text-muted;
                                            font-size: 11px;
                                            letter-spacing: 1.5px;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                                if !r.is-header : TrackRow {
                            show-analysis: root.provider-analyses;
                                    width: 100%;
                                    height: 42px;
                                    use-track-no: true;
                                    track: r.track;
                                    current: !root.stopped && r.track.title == root.now-title && r.track.artist == root.now-artist;
                                    play => { root.play-album-track(root.detail-album.id, r.track.index); }
                            playlists: root.playlists;
                            like-toggled => { root.track-like(r.track.id); }
                            play-next => { root.track-insert(r.track.id, -2); }
                            add-queue => { root.track-insert(r.track.id, -3); }
                            go-album => { root.open-album(r.track.album-id); }
                            add-to-playlist(plid) => { root.track-add-to-playlist(plid, r.track.id); }
                                }
                            }
                        }
                    }
                }


                if !root.show-detail && !root.show-artist && ((root.current-tab == 0 && root.albums.length == 0)
                    || (root.current-tab == 1 && root.artists.length == 0)
                    || (root.current-tab == 2 && root.tracks.length == 0)
                    || (root.current-tab == 3 && root.liked.length == 0)) : Text {
                    text: root.connected
                        ? "Nothing here yet — scan your library with `music-player scan`."
                        : "Waiting for music-player at " + root.status-text;
                    color: Theme.text-muted;
                    font-size: 13px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }
            }

            // ── Player bar ──────────────────────────────────────────────────
            player := Rectangle {
                height: 92px;
                clip: true;
                background: root.show-full-player ? #100c18dd : Theme.panel-bg;
                if root.show-full-player && root.now-has-art : Image {
                    x: -20px;
                    y: -20px;
                    width: parent.width + 40px;
                    height: parent.height + 40px;
                    source: root.now-art-blurred;
                    image-fit: cover;
                    opacity: 0.28;
                }
                if root.show-full-player : Rectangle {
                    width: parent.width;
                    height: parent.height;
                    background: #100c18aa;
                }
                Rectangle { height: 1px; y: 0; width: parent.width; background: Theme.border; }

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 18px;

                    // Track info
                    HorizontalLayout {
                        spacing: 12px;
                        width: root.show-full-player ? 38% : (root.now-has-art ? 24% : 32%);
                        Rectangle {
                            // A station without a logo still gets the slot, so
                            // the bar does not reflow when one loads.
                            visible: !root.show-full-player && (root.now-has-art || root.now-is-radio);
                            width: 60px;
                            height: 60px;
                            y: (parent.height - self.height) / 2;
                            background: Theme.art-placeholder;
                            clip: true;
                            if root.now-has-art : Image {
                                width: parent.width;
                                height: parent.height;
                                source: root.now-art;
                                image-fit: cover;
                            }
                            if !root.now-has-art && root.now-is-radio : Image {
                                source: Icons.broadcast;
                                colorize: Theme.accent;
                                width: 24px;
                                height: 24px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                            art-touch := TouchArea {
                                enabled: !root.stopped;
                                mouse-cursor: pointer;
                                clicked => { root.show-full-player = true; }
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 3px;
                            // A long song title (or an ICY `StreamTitle`)
                            // scrolls itself rather than being cut off.
                            MarqueeText {
                                text: root.now-title;
                                text-color: Theme.text;
                                font-size: 13px;
                                font-weight: 600;
                            }
                            MarqueeText {
                                text: root.now-subtitle;
                                text-color: Theme.text-dim;
                                font-size: 11px;
                            }
                        }
                        if !root.now-is-radio : LikeButton {
                            liked: root.now-liked;
                            icon-size: 21px;
                            width: 32px;
                            height: 32px;
                            // align with the TITLE line (upper of the two rows)
                            y: (parent.height - self.height) / 2 - 8px;
                            clicked => {
                                if (root.now-track-id != "") {
                                    root.track-like(root.now-track-id);
                                }
                            }
                        }
                        // For a station the heart is the bookmark.
                        if root.now-is-radio : LikeButton {
                            liked: root.now-radio-bookmarked;
                            icon-size: 21px;
                            width: 32px;
                            height: 32px;
                            y: (parent.height - self.height) / 2 - 8px;
                            clicked => {
                                if (root.now-station-id != "") {
                                    root.now-radio-bookmarked = !root.now-radio-bookmarked;
                                    root.radio-bookmark(root.now-station-id);
                                }
                            }
                        }
                    }

                    // Transport + seek
                    VerticalLayout {
                        alignment: center;
                        spacing: 6px;
                        horizontal-stretch: 1;

                        HorizontalLayout {
                            alignment: center;
                            spacing: 10px;
                            if !root.now-is-radio : IconButton {
                                icon: Icons.shuffle;
                                icon-size: 15px;
                                accented: root.shuffle;
                                y: (parent.height - self.height) / 2;
                                clicked => { root.toggle-shuffle(); }
                            }
                            if !root.now-is-radio : IconButton {
                                icon: Icons.prev;
                                icon-size: 17px;
                                y: (parent.height - self.height) / 2;
                                clicked => { root.previous(); }
                            }
                            PlayPauseButton {
                                playing: root.playing;
                                clicked => { root.play-pause(); }
                            }
                            if !root.now-is-radio : IconButton {
                                icon: Icons.next;
                                icon-size: 17px;
                                y: (parent.height - self.height) / 2;
                                clicked => { root.next(); }
                            }
                            if !root.now-is-radio : repeat-btn := IconButton {
                                icon: Icons.repeat;
                                icon-size: 15px;
                                accented: root.repeat-mode > 0;
                                y: (parent.height - self.height) / 2;
                                clicked => { root.cycle-repeat(); }
                                // repeat-one badge
                                if root.repeat-mode == 2 : Rectangle {
                                    width: 12px;
                                    height: 12px;
                                    x: parent.width - 10px;
                                    y: 2px;
                                    border-radius: 6px;
                                    background: Theme.accent;
                                    Text {
                                        text: "1";
                                        color: Theme.on-accent;
                                        font-size: 8px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                        if !root.now-is-radio : HorizontalLayout {
                            spacing: 10px;
                            Text {
                                text: root.elapsed-text;
                                color: Theme.text-muted;
                                font-size: 10px;
                                font-family: Theme.font-mono;
                                vertical-alignment: center;
                            }
                            SlideBar {
                                progress: root.progress;
                                changed(p) => { root.seek(p); }
                            }
                            Text {
                                text: root.duration-text;
                                color: Theme.text-muted;
                                font-size: 10px;
                                font-family: Theme.font-mono;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // VFD + volume
                    HorizontalLayout {
                        spacing: 10px;
                        IconButton {
                            icon: Icons.equalizer;
                            icon-size: 16px;
                            accented: root.show-audio;
                            y: (parent.height - self.height) / 2;
                            clicked => { root.show-audio = !root.show-audio; }
                        }
                        // Where the audio comes out. The queue has the right
                        // panel, so the miniplayer's slot is better spent here.
                        IconButton {
                            icon: Icons.device-speaker;
                            icon-size: 17px;
                            accented: root.current-renderer != "";
                            y: (parent.height - self.height) / 2;
                            clicked => {
                                root.show-renderers = true;
                                root.renderers-open();
                            }
                        }
                        VfdDisplay {
                            y: (parent.height - self.height) / 2;
                            // A live stream has no meaningful position, so the
                            // readout names the source instead of counting.
                            time-text: root.now-is-radio ? "RADIO" : root.elapsed-text;
                            info-text: root.vfd-info;
                            playing: root.playing;
                            stopped: root.stopped;
                            vu-left: root.vu-left;
                            vu-right: root.vu-right;
                        }
                        // Mute is a button as well as `m`: a shortcut nobody
                        // can see is a shortcut nobody uses.
                        IconButton {
                            icon: root.muted ? Icons.volume-mute : Icons.volume;
                            icon-size: 17px;
                            accented: root.muted;
                            y: (parent.height - self.height) / 2;
                            clicked => { root.toggle-mute(); }
                        }
                        Rectangle {
                            width: 72px;
                            Knob {
                                x: (parent.width - self.width) / 2;
                                // shift up half the value-text height so the
                                // knob FACE (not the whole unit) is centered
                                y: (parent.height - self.height) / 2 - 4px;
                                height: 74px;
                                size: 56px;
                                gap: 2px;
                                label: "";
                                // Muted keeps the level, so the readout says so
                                // rather than showing a number you cannot hear.
                                value-text: root.muted ? "muted" : round(root.volume * 100) + "%";
                                norm: root.volume;
                                default-norm: 0.75;
                                changed(p) => {
                                    root.bump-volume(p - root.volume);
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Full-window now-playing canvas. The normal miniplayer remains below it.
    full-player := Rectangle {
        visible: root.show-full-player;
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height - 92px;
        background: Theme.window-bg;
        if root.now-has-art : Image {
            width: parent.width;
            height: parent.height;
            source: root.now-art-blurred;
            image-fit: cover;
            opacity: 0.48;
        }
        // Tinted with the window colour rather than a fixed near-black: the
        // controls on this canvas are themed, and a dark scrim under a light
        // skin left all of them dark on dark.
        Rectangle {
            width: parent.width;
            height: parent.height;
            background: Theme.window-bg.with-alpha(0.78);
        }
        IconButton { x: 22px; y: 22px + root.titlebar-inset; icon: Icons.chevron-left; icon-size: 20px; width: 42px; height: 42px; clicked => { root.show-full-player = false; } }
        // One width for the artwork, the waveform and the equalizer, so the
        // three read as a single column rather than three stacked things.
        //
        // Bounded by the *height* as well as the width, because the artwork is
        // square: a column as wide as the window would be taller than it, and
        // the art would be cropped or pushed off the bottom.
        property <length> column-width: min(480px, parent.width - 180px, parent.height - 250px);

        VerticalLayout {
            x: (parent.width - self.width) / 2;
            y: 70px;
            width: full-player.column-width;
            // Reclaims the equalizer's strip when it is hidden, so the artwork
            // grows rather than leaving a gap where it was.
            height: parent.height - (root.show-equalizer ? 174px : 110px);
            alignment: center;
            spacing: 16px;
            Rectangle {
                // The full column width, so it lines up with the waveform below
                // it exactly. It was sized off the container height before,
                // which made it both smaller than the waveform and, since a
                // width inside a VerticalLayout does not centre, sat to one
                // side of it.
                width: parent.width;
                height: self.width;
                background: Theme.art-placeholder;
                clip: true;
                drop-shadow-color: #000000aa;
                drop-shadow-blur: 40px;
                if root.now-has-art : Image { width: parent.width; height: parent.height; source: root.now-art; image-fit: cover; }
                if !root.now-has-art : Image { source: Icons.music; colorize: Theme.text-muted; width: parent.width * 0.3; height: self.width; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
            }

            // The track's own waveform, from the daemon's analysis, doubling as
            // a seek bar. It shows *where* in the song you are aiming — the
            // quiet intro, the drop — which a progress bar cannot.
            waveform := Rectangle {
                height: 48px;
                // A live stream has no length and no waveform to draw.
                visible: !root.now-is-radio;

                // A flat line while nothing has been analysed, so opening the
                // player does not shift everything when the bars arrive.
                if root.waveform-bars.length == 0 : Rectangle {
                    y: (parent.height - 2px) / 2;
                    width: parent.width;
                    height: 2px;
                    background: Theme.border;
                }

                HorizontalLayout {
                    width: parent.width;
                    height: parent.height;
                    alignment: stretch;
                    spacing: 1px;
                    for level[i] in root.waveform-bars : Rectangle {
                        // Never zero: a silent passage is a quiet part of the
                        // track, not a gap in it.
                        height: max(3px, level * parent.height);
                        y: (parent.height - self.height) / 2;
                        border-radius: 1px;
                        background: (i + 1) / root.waveform-bars.length <= root.waveform-progress
                            ? Theme.accent : Theme.border;
                    }
                }

                TouchArea {
                    width: parent.width;
                    height: parent.height;
                    // The same callback the progress bar uses: one way to seek.
                    clicked => { root.seek(self.pressed-x / parent.width); }
                }
            }

        }

        // Full-bleed along the bottom edge, flush against the miniplayer
        // rather than boxed into the column above. The equalizer is the audio
        // leaving the machine, not a property of the track — so it spans the
        // window, while the waveform, which *is* the track, stays with the art.
        Rectangle {
            visible: root.show-equalizer;
            x: 0;
            y: parent.height - self.height;
            width: parent.width;
            height: 64px;
            opacity: 0.9;
            HorizontalLayout {
                width: parent.width;
                height: parent.height;
                alignment: stretch;
                // Nearly touching: with this many bars a wide gap reads as a
                // row of separate objects rather than one moving surface.
                spacing: 1px;
                for level[i] in root.eq-bars : Rectangle {
                    // A flat colour, not a ramp: the bars are distinguished by
                    // height already, and a gradient on top of that reads as a
                    // second signal competing with the first.
                    Rectangle {
                        width: parent.width;
                        height: max(2px, level * parent.height);
                        y: parent.height - self.height;
                        border-top-left-radius: 2px;
                        border-top-right-radius: 2px;
                        background: Theme.accent;
                        // Smooths between ticks, which arrive at 20 Hz —
                        // without it the bars step visibly rather than moving.
                        animate height { duration: 90ms; easing: ease-out; }
                    }
                    // The cap floats clear of the bar rather than resting on
                    // it, so a peak that has already decayed still shows the
                    // level it reached.
                    Rectangle {
                        property <float> peak: root.eq-peaks[i];
                        visible: self.peak > 0.02;
                        width: parent.width;
                        height: 3px;
                        y: max(0px, parent.height - self.peak * parent.height - 3px);
                        border-radius: 1.5px;
                        background: Theme.accent;
                        opacity: 0.55;
                        animate y { duration: 90ms; easing: ease-out; }
                    }
                }
            }
        }
    }

    // ── Queue drawer ────────────────────────────────────────────────────────
    queue-layer := Rectangle {
        visible: root.show-queue;
        x: parent.width - self.width;
        y: 0;
        width: 320px;
        height: parent.height - 92px;
        background: Theme.panel-bg;
        border-width: 1px;
        border-color: Theme.border;

        VerticalLayout {
            HorizontalLayout {
                padding: 16px;
                padding-bottom: 10px;
                Text {
                    text: "Queue";
                    color: Theme.text;
                    font-size: 15px;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Text {
                    text: root.queue-total == 1 ? "1 track" : root.queue-total + " tracks";
                    color: Theme.text-muted;
                    font-size: 11px;
                    font-family: Theme.font-mono;
                    vertical-alignment: center;
                }
                IconButton {
                    icon: Icons.trash;
                    icon-size: 14px;
                    y: (parent.height - self.height) / 2;
                    clicked => { root.queue-clear(); }
                }
                IconButton {
                    icon: Icons.close;
                    icon-size: 15px;
                    y: (parent.height - self.height) / 2;
                    clicked => { root.show-queue = false; }
                }
            }

            // Tab bar
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-bottom: 10px;
                spacing: 8px;
                Rectangle {
                    height: 28px;
                    horizontal-stretch: 1;
                    border-radius: 14px;
                    background: root.queue-tab == 0 ? Theme.selected-bg
                        : pq-touch.has-hover ? Theme.hover-bg : transparent;
                    border-width: root.queue-tab == 0 ? 1px : 0px;
                    border-color: Theme.accent.with-alpha(0.4);
                    Text {
                        text: "Play Queue";
                        color: root.queue-tab == 0 ? Theme.accent : Theme.text-dim;
                        font-size: 11px;
                        font-weight: root.queue-tab == 0 ? 600 : 400;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    pq-touch := TouchArea {
                        clicked => { root.queue-tab = 0; }
                        mouse-cursor: pointer;
                    }
                }
                Rectangle {
                    height: 28px;
                    horizontal-stretch: 1;
                    border-radius: 14px;
                    background: root.queue-tab == 1 ? Theme.selected-bg
                        : hist-touch.has-hover ? Theme.hover-bg : transparent;
                    border-width: root.queue-tab == 1 ? 1px : 0px;
                    border-color: Theme.accent.with-alpha(0.4);
                    Text {
                        text: "History";
                        color: root.queue-tab == 1 ? Theme.accent : Theme.text-dim;
                        font-size: 11px;
                        font-weight: root.queue-tab == 1 ? 600 : 400;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    hist-touch := TouchArea {
                        clicked => { root.queue-tab = 1; }
                        mouse-cursor: pointer;
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.border; }

            // ── Play Queue tab ──────────────────────────────────────────────
            if root.queue-tab == 0 : VerticalLayout {
                vertical-stretch: 1;

                // Now Playing card
                if !root.stopped : VerticalLayout {
                    padding: 12px;
                    padding-bottom: 8px;
                    spacing: 8px;
                    Text {
                        text: "NOW PLAYING";
                        color: Theme.text-muted;
                        font-size: 9px;
                        letter-spacing: 1.5px;
                    }
                    Rectangle {
                        height: 64px;
                        border-radius: Theme.control-radius;
                        background: Theme.selected-bg;
                        border-width: 1px;
                        border-color: Theme.accent.with-alpha(0.3);
                        HorizontalLayout {
                            padding: 10px;
                            spacing: 10px;
                            Rectangle {
                                width: 44px;
                                height: 44px;
                                background: Theme.art-placeholder;
                                clip: true;
                                if root.now-has-art : Image {
                                    width: parent.width;
                                    height: parent.height;
                                    source: root.now-art;
                                    image-fit: cover;
                                }
                                if !root.now-has-art : Image {
                                    source: Icons.music;
                                    colorize: Theme.text-muted;
                                    width: 18px;
                                    height: 18px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                horizontal-stretch: 1;
                                Text {
                                    text: root.now-title;
                                    color: Theme.accent;
                                    font-size: 12px;
                                    font-weight: 600;
                                    overflow: elide;
                                }
                                Text {
                                    text: root.now-subtitle;
                                    color: Theme.text-dim;
                                    font-size: 10px;
                                    overflow: elide;
                                }
                            }
                            Image {
                                source: root.playing ? Icons.play : Icons.pause;
                                colorize: Theme.accent;
                                width: 13px;
                                height: 13px;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                    }
                }

                // Up Next
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 6px;
                    padding-bottom: 4px;
                    Text {
                        text: "UP NEXT";
                        color: Theme.text-muted;
                        font-size: 9px;
                        letter-spacing: 1.5px;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: root.queue-upnext.length == 1 ? "1 track"
                            : root.queue-upnext.length + " tracks";
                        color: Theme.text-muted;
                        font-size: 9px;
                        font-family: Theme.font-mono;
                    }
                }
                ListView {
                    vertical-stretch: 1;
                    for t[i] in root.queue-upnext : Rectangle {
                        height: 46px;
                        background: unext-touch.has-hover ? Theme.hover-bg : transparent;
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 10px;
                            Text {
                                text: i + 1;
                                color: Theme.text-muted;
                                font-size: 11px;
                                font-family: Theme.font-mono;
                                vertical-alignment: center;
                                horizontal-alignment: right;
                                width: 24px;
                            }
                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                horizontal-stretch: 1;
                                Text {
                                    text: t.title;
                                    color: Theme.text;
                                    font-size: 12px;
                                    overflow: elide;
                                }
                                Text {
                                    text: t.artist;
                                    color: Theme.text-dim;
                                    font-size: 10px;
                                    overflow: elide;
                                }
                            }
                            Text {
                                text: t.duration;
                                color: Theme.text-muted;
                                font-size: 10px;
                                font-family: Theme.font-mono;
                                vertical-alignment: center;
                            }
                            IconButton {
                                icon: Icons.close;
                                icon-size: 13px;
                                width: 26px;
                                height: 26px;
                                y: (parent.height - self.height) / 2;
                                opacity: unext-touch.has-hover ? 1 : 0;
                                clicked => { root.queue-remove(t.index); }
                            }
                        }
                        unext-touch := TouchArea {
                            clicked => { root.play-queue-at(t.index); }
                            mouse-cursor: pointer;
                        }
                    }
                }
                if root.queue-upnext.length == 0 : Text {
                    text: "Nothing up next";
                    color: Theme.text-muted;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    vertical-stretch: 1;
                }
            }

            // ── History tab ─────────────────────────────────────────────────
            if root.queue-tab == 1 : VerticalLayout {
                vertical-stretch: 1;
                ListView {
                    vertical-stretch: 1;
                    for t[i] in root.queue-history : Rectangle {
                        height: 46px;
                        background: hrow-touch.has-hover ? Theme.hover-bg : transparent;
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 10px;
                            Image {
                                source: Icons.music;
                                colorize: Theme.text-muted;
                                width: 13px;
                                height: 13px;
                                y: (parent.height - self.height) / 2;
                            }
                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                horizontal-stretch: 1;
                                Text {
                                    text: t.title;
                                    color: Theme.text;
                                    font-size: 12px;
                                    overflow: elide;
                                }
                                Text {
                                    text: t.artist;
                                    color: Theme.text-dim;
                                    font-size: 10px;
                                    overflow: elide;
                                }
                            }
                            Text {
                                text: t.duration;
                                color: Theme.text-muted;
                                font-size: 10px;
                                font-family: Theme.font-mono;
                                vertical-alignment: center;
                            }
                            IconButton {
                                icon: Icons.close;
                                icon-size: 13px;
                                width: 26px;
                                height: 26px;
                                y: (parent.height - self.height) / 2;
                                opacity: hrow-touch.has-hover ? 1 : 0;
                                clicked => { root.queue-remove(t.index); }
                            }
                        }
                        hrow-touch := TouchArea {
                            clicked => { root.play-queue-at(t.index); }
                            mouse-cursor: pointer;
                        }
                    }
                }
                if root.queue-history.length == 0 : Text {
                    text: "No history yet";
                    color: Theme.text-muted;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    vertical-stretch: 1;
                }
            }
        }
    }

    // ── Audio settings modal ────────────────────────────────────────────────
    audio-layer := Rectangle {
        visible: root.show-audio;
        width: 100%;
        height: 100%;
        background: #000000a0;

        TouchArea {
            clicked => { root.show-audio = false; }
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: max(30px, (parent.height - self.height) / 2);
            width: min(780px, parent.width - 60px);
            height: min(700px, parent.height - 50px);
            border-radius: 14px;
            background: Theme.panel-bg;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-color: #000000aa;
            drop-shadow-blur: 40px;
            clip: true;

            TouchArea {} // swallow clicks

            VerticalLayout {
                padding: 22px;
                spacing: 8px;

                HorizontalLayout {
                    spacing: 10px;
                    padding-bottom: 6px;
                    Image {
                        source: Icons.equalizer;
                        colorize: Theme.accent;
                        width: 18px;
                        height: 18px;
                        y: (parent.height - self.height) / 2;
                    }
                    Text {
                        text: "Audio Settings";
                        color: Theme.text;
                        font-size: 16px;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: "esc to close";
                        color: Theme.text-muted;
                        font-size: 10px;
                        font-family: Theme.font-mono;
                        vertical-alignment: center;
                    }
                }

                Flickable {
                    vertical-stretch: 1;
                    viewport-height: audio-content.preferred-height + 20px;

                    audio-content := VerticalLayout {
                        width: parent.width;
                        spacing: 10px;

                        // ── Equalizer ───────────────────────────────────────
                        SectionHeader { title: "EQUALIZER"; }
                        HorizontalLayout {
                            spacing: 10px;
                            height: 26px;
                            Text {
                                text: "Enable EQ";
                                color: Theme.text-dim;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                            Toggle {
                                checked: root.eq-enabled;
                                y: (parent.height - self.height) / 2;
                                toggled => { root.audio-set("eq_enabled", root.eq-enabled ? 0 : 1); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        eq-row := HorizontalLayout {
                            spacing: 2px;
                            height: 150px;
                            opacity: root.eq-enabled ? 1 : 0.35;
                            for b[i] in root.eq-bands : EqBandSlider {
                                gain: b.gain;
                                freq-label: b.cutoff >= 1000 ? (b.cutoff / 1000) + "k" : b.cutoff + "";
                                horizontal-stretch: 1;
                                changed(g) => { root.eq-band-set(i, g); }
                            }
                            Rectangle {
                                width: 1px;
                                height: parent.height - 30px;
                                y: 15px;
                                background: Theme.border;
                            }
                            VerticalLayout {
                                alignment: center;
                                Knob {
                                    label: "Precut";
                                    value-text: (root.eq-precut / 10.0) + " dB";
                                    norm: root.eq-precut / 240.0;
                                    default-norm: 0;
                                    changed(p) => { root.audio-set("eq_precut", round(p * 48) * 5); }
                                }
                            }
                        }

                        // ── Tone + ReplayGain (two columns) ─────────────────
                        HorizontalLayout {
                            spacing: 18px;

                            // Left column: tone knobs + output toggle
                            VerticalLayout {
                                spacing: 10px;
                                horizontal-stretch: 1;
                                SectionHeader { title: "TONE"; }
                                HorizontalLayout {
                                    spacing: 22px;
                                    padding-top: 2px;
                                    alignment: center;
                                    Knob {
                                        label: "Bass";
                                        value-text: root.bass + " dB";
                                        norm: root.bass-max == root.bass-min ? 0
                                            : (root.bass - root.bass-min) / (root.bass-max - root.bass-min);
                                        default-norm: root.bass-max == root.bass-min ? 0
                                            : (0.0 - root.bass-min) / (root.bass-max - root.bass-min);
                                        // Cut and boost grow out of 0 dB.
                                        origin-norm: root.bass-max == root.bass-min ? 0
                                            : (0.0 - root.bass-min) / (root.bass-max - root.bass-min);
                                        changed(p) => {
                                            root.audio-set("bass", root.bass-min + round(p * (root.bass-max - root.bass-min)));
                                        }
                                    }
                                    Knob {
                                        label: "Treble";
                                        value-text: root.treble + " dB";
                                        norm: root.treble-max == root.treble-min ? 0
                                            : (root.treble - root.treble-min) / (root.treble-max - root.treble-min);
                                        default-norm: root.treble-max == root.treble-min ? 0
                                            : (0.0 - root.treble-min) / (root.treble-max - root.treble-min);
                                        origin-norm: root.treble-max == root.treble-min ? 0
                                            : (0.0 - root.treble-min) / (root.treble-max - root.treble-min);
                                        changed(p) => {
                                            root.audio-set("treble", root.treble-min + round(p * (root.treble-max - root.treble-min)));
                                        }
                                    }
                                    Knob {
                                        label: "Balance";
                                        value-text: root.balance == 0 ? "center"
                                            : root.balance < 0 ? (-root.balance) + "% L"
                                            : root.balance + "% R";
                                        norm: (root.balance + 100) / 200.0;
                                        // L and R grow out of centre, not from
                                        // hard left.
                                        origin-norm: 0.5;
                                        changed(p) => { root.audio-set("balance", round(p * 200) - 100); }
                                    }
                                }
                            }

                            Rectangle {
                                width: 1px;
                                background: Theme.border;
                            }

                            // Right column: replaygain
                            VerticalLayout {
                                spacing: 10px;
                                horizontal-stretch: 1;
                                SectionHeader { title: "REPLAYGAIN"; }
                                HorizontalLayout {
                                    spacing: 16px;
                                    VerticalLayout {
                                        spacing: 14px;
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        HorizontalLayout {
                                            spacing: 10px;
                                            Text {
                                                text: "Mode";
                                                color: Theme.text-dim;
                                                font-size: 12px;
                                                vertical-alignment: center;
                                                width: 44px;
                                            }
                                            Dropdown {
                                                options: ["Track", "Album", "Track (shuffle)", "Off"];
                                                current: root.rg-type;
                                                selected(i) => { root.audio-set("rg_type", i); }
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                        }
                                        HorizontalLayout {
                                            spacing: 10px;
                                            Text {
                                                text: "Prevent clipping";
                                                color: Theme.text-dim;
                                                font-size: 12px;
                                                vertical-alignment: center;
                                            }
                                            Toggle {
                                                checked: root.rg-noclip;
                                                y: (parent.height - self.height) / 2;
                                                toggled => { root.audio-set("rg_noclip", root.rg-noclip ? 0 : 1); }
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                        }
                                    }
                                    Knob {
                                        label: "Pre-amp";
                                        value-text: (root.rg-preamp / 10.0) + " dB";
                                        norm: (root.rg-preamp + 120) / 240.0;
                                        // 0 dB sits at the middle of ±12 dB.
                                        origin-norm: 0.5;
                                        changed(p) => { root.audio-set("rg_preamp", round(p * 48) * 5 - 120); }
                                    }
                                }
                            }
                        }

                        // ── Crossfade ───────────────────────────────────────
                        SectionHeader { title: "CROSSFADE"; }
                        HorizontalLayout {
                            spacing: 12px;
                            height: 26px;
                            Text {
                                text: "Mode";
                                color: Theme.text-dim;
                                font-size: 12px;
                                vertical-alignment: center;
                                width: 44px;
                            }
                            Dropdown {
                                options: ["Off", "Auto track change", "Manual track change",
                                    "Shuffle", "Shuffle or manual skip", "Always"];
                                current: root.crossfade;
                                menu-width: 230px;
                                y: (parent.height - self.height) / 2;
                                selected(i) => { root.audio-set("crossfade", i); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Text {
                                text: "Fade out";
                                color: Theme.text-dim;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                            Dropdown {
                                options: ["Crossfade", "Mix"];
                                current: root.fade-out-mixmode == 2 ? 1 : 0;
                                menu-width: 140px;
                                y: (parent.height - self.height) / 2;
                                selected(i) => { root.audio-set("fade_out_mixmode", i == 1 ? 2 : 0); }
                            }
                            Text {
                                text: "Dithering";
                                color: Theme.text-dim;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                            Toggle {
                                checked: root.dithering;
                                y: (parent.height - self.height) / 2;
                                toggled => { root.audio-set("dithering", root.dithering ? 0 : 1); }
                            }
                        }
                        fade-rows := HorizontalLayout {
                            spacing: 26px;
                            padding-top: 2px;
                            alignment: center;
                            opacity: root.crossfade == 0 ? 0.35 : 1;
                            Knob {
                                label: "In delay";
                                value-text: root.fade-in-delay + " s";
                                norm: root.fade-in-delay / 7.0;
                                default-norm: 0;
                                changed(p) => { root.audio-set("fade_in_delay", round(p * 7)); }
                            }
                            Knob {
                                label: "In duration";
                                value-text: root.fade-in-duration + " s";
                                norm: root.fade-in-duration / 15.0;
                                default-norm: 2.0 / 15.0;
                                changed(p) => { root.audio-set("fade_in_duration", round(p * 15)); }
                            }
                            Knob {
                                label: "Out delay";
                                value-text: root.fade-out-delay + " s";
                                norm: root.fade-out-delay / 7.0;
                                default-norm: 0;
                                changed(p) => { root.audio-set("fade_out_delay", round(p * 7)); }
                            }
                            Knob {
                                label: "Out duration";
                                value-text: root.fade-out-duration + " s";
                                norm: root.fade-out-duration / 15.0;
                                default-norm: 2.0 / 15.0;
                                changed(p) => { root.audio-set("fade_out_duration", round(p * 15)); }
                            }
                        }
                    }
                }
            }
        }
    }

    // ── Sign in (atproto) ───────────────────────────────────────────────────
    signin-layer := Rectangle {
        visible: root.show-signin;
        width: 100%;
        height: 100%;
        background: #000000a0;

        TouchArea {
            clicked => {
                root.show-signin = false;
                main-focus.focus();
            }
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: max(40px, (parent.height - self.height) / 2);
            width: min(420px, parent.width - 60px);
            height: 372px;
            border-radius: 14px;
            background: Theme.panel-bg;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-color: #000000aa;
            drop-shadow-blur: 40px;
            clip: true;

            TouchArea {} // swallow clicks

            VerticalLayout {
                padding: 18px;
                spacing: 12px;

                HorizontalLayout {
                    spacing: 10px;
                    Image {
                        source: Icons.user-circle;
                        colorize: Theme.accent;
                        width: 18px;
                        height: 18px;
                        y: (parent.height - self.height) / 2;
                    }
                    Text {
                        text: "Sign in with Atmosphere";
                        color: Theme.text;
                        font-size: 16px;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                }

                signin-handle := FormField {
                    label: "HANDLE";
                    placeholder: "@atmosphere.handle";
                }
                signin-password := FormField {
                    label: "APP PASSWORD";
                    password: true;
                    placeholder: "xxxx-xxxx-xxxx-xxxx";
                }

                Text {
                    text: "An app password, not your account password — create one in your PDS settings. Signing in also enables scrobbling and station sync, which share this session.";
                    color: Theme.text-muted;
                    font-size: 11px;
                    wrap: word-wrap;
                }
                Text {
                    text: "No account yet? music-player is part of the Atmosphere. Create an Atmosphere account on Bluesky to get started.";
                    color: Theme.text-muted;
                    font-size: 11px;
                    wrap: word-wrap;
                }
                if root.signin-error != "" : Text {
                    text: root.signin-error;
                    color: Theme.meter-high;
                    font-size: 11px;
                    wrap: word-wrap;
                }

                Rectangle { vertical-stretch: 1; }

                HorizontalLayout {
                    alignment: end;
                    spacing: 10px;
                    height: 34px;
                    Rectangle {
                        width: 92px;
                        border-radius: 17px;
                        border-width: 1px;
                        border-color: Theme.border;
                        background: signin-cancel-touch.has-hover ? Theme.hover-bg : transparent;
                        Text {
                            text: "Cancel";
                            color: Theme.text-dim;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        signin-cancel-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.show-signin = false;
                                main-focus.focus();
                            }
                        }
                    }
                    Rectangle {
                        width: 106px;
                        border-radius: 17px;
                        background: root.signin-busy
                            ? Theme.panel-raised
                            : (signin-submit-touch.has-hover ? Theme.accent.brighter(0.15) : Theme.accent);
                        Text {
                            text: root.signin-busy ? "Signing in…" : "Sign in";
                            color: root.signin-busy ? Theme.text-muted : #ffffff;
                            font-size: 12px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        signin-submit-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                if (!root.signin-busy) {
                                    root.signin-busy = true;
                                    root.sign-in(signin-handle.text, signin-password.text);
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ── Play to (renderers) ─────────────────────────────────────────────────
    renderers-layer := Rectangle {
        visible: root.show-renderers;
        width: 100%;
        height: 100%;
        background: #000000a0;

        TouchArea {
            clicked => {
                root.show-renderers = false;
                main-focus.focus();
            }
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: max(30px, (parent.height - self.height) / 2);
            width: min(440px, parent.width - 60px);
            height: min(420px, parent.height - 60px);
            border-radius: 14px;
            background: Theme.panel-bg;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-color: #000000aa;
            drop-shadow-blur: 40px;
            clip: true;

            TouchArea {} // swallow clicks

            VerticalLayout {
                padding: 18px;
                spacing: 8px;

                HorizontalLayout {
                    spacing: 10px;
                    padding-bottom: 4px;
                    Image {
                        source: Icons.cast;
                        colorize: Theme.accent;
                        width: 18px;
                        height: 18px;
                        y: (parent.height - self.height) / 2;
                    }
                    Text {
                        text: "Play to";
                        color: Theme.text;
                        font-size: 16px;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: "esc to close";
                        color: Theme.text-muted;
                        font-size: 10px;
                        font-family: Theme.font-mono;
                        vertical-alignment: center;
                    }
                }

                ListView {
                    vertical-stretch: 1;
                    for r in root.renderers : RendererRow {
                        renderer: r;
                        activate => {
                            root.renderer-activate(r.id, r.cast);
                            root.show-renderers = false;
                        }
                    }
                }

                // This machine is always an option, so an empty network is a
                // note under the list rather than an empty state instead of it.
                if root.renderers.length <= 1 : Text {
                    text: "Chromecasts, UPnP/DLNA renderers and other music-player instances on this network show up here.";
                    color: Theme.text-muted;
                    font-size: 11px;
                    wrap: word-wrap;
                }
            }
        }
    }

    // ── Radio search ────────────────────────────────────────────────────────
    radio-search-layer := Rectangle {
        visible: root.show-radio-search;
        width: 100%; height: 100%; background: #000000a0;
        TouchArea { clicked => { root.show-radio-search = false; } }
        Rectangle {
            x: (parent.width - self.width) / 2; y: 84px;
            width: min(620px, parent.width - 80px); height: min(480px, parent.height - 168px);
            border-radius: 14px; background: Theme.panel-bg; border-width: 1px; border-color: Theme.border;
            drop-shadow-color: #000000aa; drop-shadow-blur: 40px; clip: true;
            TouchArea {}
            VerticalLayout {
                HorizontalLayout {
                    padding: 18px; spacing: 12px;
                    Image { source: Icons.broadcast; colorize: Theme.accent; width: 18px; height: 18px; y: (parent.height - self.height) / 2; }
                    radio-input := TextInput {
                        horizontal-stretch: 1; height: 28px; color: Theme.text; font-size: 17px; single-line: true;
                        edited => {
                            root.radios = [];
                            root.radio-loading = self.text != "";
                            root.radio-search(self.text);
                        }
                    }
                    Text { text: "esc"; color: Theme.text-muted; font-size: 10px; vertical-alignment: center; }
                }
                Rectangle { height: 1px; background: Theme.border; }
                if root.radio-loading : RadioSkeletonList { vertical-stretch: 1; rows: 6; }
                if !root.radio-loading : ListView {
                    for station in root.radios : RadioRow {
                        station: station;
                        play => { root.radio-play(station.id); root.show-radio-search = false; }
                        bookmark => { root.radio-bookmark(station.id); }
                    }
                }
            }
        }
    }

    // ── Command palette ─────────────────────────────────────────────────────
    palette-layer := Rectangle {
        visible: root.show-palette;
        width: 100%;
        height: 100%;
        background: #000000a0;

        TouchArea {
            clicked => { root.close-palette(); }
        }
        palette-panel := Rectangle {
            x: (parent.width - self.width) / 2;
            y: 84px;
            width: min(620px, parent.width - 80px);
            height: min(440px, parent.height - 168px);
            border-radius: 14px;
            background: Theme.panel-bg;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-color: #000000aa;
            drop-shadow-blur: 40px;
            clip: true;

            TouchArea {} // swallow backdrop clicks under the panel

            VerticalLayout {
                HorizontalLayout {
                    padding: 18px;
                    spacing: 12px;
                    Image {
                        source: Icons.search;
                        colorize: Theme.accent;
                        width: 18px;
                        height: 18px;
                        y: (parent.height - self.height) / 2;
                    }
                    palette-scope := FocusScope {
                        height: 24px;
                        key-pressed(event) => {
                            if (event.text == Key.DownArrow) {
                                root.palette-sel = min(root.palette-sel + 1, root.palette-results.length - 1);
                                return accept;
                            }
                            if (event.text == Key.UpArrow) {
                                root.palette-sel = max(root.palette-sel - 1, 0);
                                return accept;
                            }
                            if (event.text == Key.Escape) {
                                root.close-palette();
                                return accept;
                            }
                            reject
                        }
                        palette-input := TextInput {
                            width: 100%;
                            height: 100%;
                            color: Theme.text;
                            font-size: 17px;
                            font-family: Theme.font-ui;
                            single-line: true;
                            vertical-alignment: center;
                            edited => {
                                root.palette-sel = 0;
                                root.palette-query(self.text);
                            }
                            accepted => { root.activate-palette(); }
                        }
                        if palette-input.text == "" : Text {
                            text: "Search tracks, albums, artists…";
                            color: Theme.text-muted;
                            font-size: 17px;
                            vertical-alignment: center;
                            height: 100%;
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }
                ListView {
                    vertical-stretch: 1;
                    for r[i] in root.palette-results : PaletteRow {
                        item: r;
                        selected: i == root.palette-sel;
                        activate => {
                            root.palette-sel = i;
                            root.activate-palette();
                        }
                        hovered => { root.palette-sel = i; }
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }
                HorizontalLayout {
                    padding: 10px;
                    padding-left: 18px;
                    spacing: 18px;
                    Text {
                        text: "up/down navigate";
                        color: Theme.text-muted;
                        font-size: 10px;
                        font-family: Theme.font-mono;
                    }
                    Text {
                        text: "enter play";
                        color: Theme.text-muted;
                        font-size: 10px;
                        font-family: Theme.font-mono;
                    }
                    Text {
                        text: "esc close";
                        color: Theme.text-muted;
                        font-size: 10px;
                        font-family: Theme.font-mono;
                    }
                }
            }
        }
    }

    // ── Add server modal ────────────────────────────────────────────────────
    server-form-layer := Rectangle {
        visible: root.show-server-form;
        width: 100%;
        height: 100%;
        background: #000000a0;

        TouchArea {
            clicked => { root.show-server-form = false; }
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 460px;
            height: srv-form-content.preferred-height;
            border-radius: 14px;
            background: Theme.panel-bg;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-color: #000000aa;
            drop-shadow-blur: 40px;

            TouchArea {}

            srv-form-content := VerticalLayout {
                padding: 24px;
                spacing: 14px;
                Text {
                    text: "Add server";
                    color: Theme.text;
                    font-size: 16px;
                    font-weight: 700;
                }
                VerticalLayout {
                    spacing: 5px;
                    Text {
                        text: "TYPE";
                        color: Theme.text-muted;
                        font-size: 10px;
                        letter-spacing: 1px;
                    }
                    kind-dd := Dropdown {
                        options: ["Subsonic / Navidrome", "Jellyfin", "music-player", "Kodi", "Plex", "Rocksky"];
                        current: 0;
                        menu-width: 190px;
                        selected(i) => { self.current = i; }
                    }
                }
                name-field := FormField {
                    label: "NAME";
                    placeholder: "Living room NAS";
                }
                if kind-dd.current == 5 : Text {
                    text: "Connects to https://navidrome.rocksky.app";
                    color: Theme.text-muted;
                    font-size: 11px;
                }
                url-field := FormField {
                    label: "SERVER URL";
                    visible: kind-dd.current != 5;
                    height: kind-dd.current == 5 ? 0px : self.preferred-height;
                    // The port each kind actually listens on, so the example is
                    // one that would work rather than one to be edited.
                    placeholder: kind-dd.current == 1 ? "http://192.168.1.10:8096"
                        : kind-dd.current == 2 ? "http://192.168.1.10:5053"
                        : kind-dd.current == 3 ? "http://192.168.1.10:8080"
                        : kind-dd.current == 4 ? "http://192.168.1.10:32400"
                        : "http://192.168.1.10:4533";
                }
                HorizontalLayout {
                    // A peer daemon has no login, so asking for one would be
                    // asking for something that gets ignored.
                    visible: kind-dd.current != 2;
                    height: kind-dd.current == 2 ? 0px : self.preferred-height;
                    spacing: 12px;
                    user-field := FormField {
                        label: "USERNAME";
                        // Plex authenticates with a token alone.
                        visible: kind-dd.current != 4;
                        horizontal-stretch: 1;
                    }
                    pass-field := FormField {
                        label: kind-dd.current == 4 ? "X-PLEX-TOKEN" : "PASSWORD";
                        password: true;
                        horizontal-stretch: 1;
                    }
                }
                HorizontalLayout {
                    padding-top: 4px;
                    spacing: 10px;
                    Rectangle { horizontal-stretch: 1; }
                    Rectangle {
                        width: 90px;
                        height: 32px;
                        border-radius: 16px;
                        background: srv-cancel-touch.has-hover ? Theme.hover-bg : transparent;
                        border-width: 1px;
                        border-color: Theme.border;
                        Text {
                            text: "Cancel";
                            color: Theme.text-dim;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        srv-cancel-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.show-server-form = false; }
                        }
                    }
                    Rectangle {
                        width: 110px;
                        height: 32px;
                        border-radius: 16px;
                        background: srv-submit-touch.has-hover ? Theme.accent-hover : Theme.accent;
                        Text {
                            text: "Add";
                            color: Theme.on-accent;
                            font-size: 12px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        srv-submit-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                if (url-field.text != "" || kind-dd.current == 5) {
                                    root.server-add(
                                        kind-dd.current == 1 ? "jellyfin"
                                            : kind-dd.current == 2 ? "music-player"
                                            : kind-dd.current == 3 ? "kodi"
                                            : kind-dd.current == 4 ? "plex"
                                            : kind-dd.current == 5 ? "rocksky"
                                            : "subsonic",
                                        name-field.text == "" ? url-field.text : name-field.text,
                                        url-field.text,
                                        user-field.text,
                                        pass-field.text);
                                    name-field.text = "";
                                    url-field.text = "";
                                    user-field.text = "";
                                    pass-field.text = "";
                                    root.show-server-form = false;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ── Add station (hand-entered internet radio) ───────────────────────────
    add-station-layer := Rectangle {
        visible: root.show-add-station;
        width: 100%;
        height: 100%;
        background: #000000a0;

        TouchArea {
            clicked => { root.close-add-station(); }
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 460px;
            height: add-station-content.preferred-height;
            border-radius: 14px;
            background: Theme.panel-bg;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-color: #000000aa;
            drop-shadow-blur: 40px;

            TouchArea {}

            add-station-content := VerticalLayout {
                padding: 24px;
                spacing: 14px;
                Text {
                    text: "Add a station";
                    color: Theme.text;
                    font-size: 16px;
                    font-weight: 700;
                }
                Text {
                    text: "Signed in to atradio.fm, it is published to your account and follows you to your other devices.";
                    color: Theme.text-muted;
                    font-size: 11px;
                    wrap: word-wrap;
                }
                FormField {
                    label: "STREAM URL";
                    placeholder: "https://example.com/stream";
                    text <=> root.add-station-url;
                    // A typed-over url invalidates the last verdict; the check
                    // itself waits until the user leaves the field, since it is
                    // a round trip to the station.
                    edited(value) => {
                        root.add-station-status = "";
                        root.add-station-ok = false;
                    }
                    committed(value) => {
                        if (value != "" && !root.add-station-checking) {
                            root.add-station-checking = true;
                            root.add-station-status = "";
                            root.radio-check-stream(value);
                        }
                    }
                }
                if root.add-station-checking || root.add-station-status != "" : Text {
                    text: root.add-station-checking ? "Checking the stream…" : root.add-station-status;
                    // The skins carry no error color, and one that shifted with
                    // the accent would read as success on half of them.
                    color: root.add-station-checking
                        ? Theme.text-muted
                        : (root.add-station-ok ? Theme.accent : #d45769);
                    font-size: 11px;
                    wrap: word-wrap;
                }
                FormField {
                    label: "NAME";
                    placeholder: "Station name";
                    text <=> root.add-station-name;
                }
                HorizontalLayout {
                    spacing: 12px;
                    FormField {
                        label: "GENRE";
                        horizontal-stretch: 1;
                        text <=> root.add-station-genre;
                    }
                    FormField {
                        label: "COUNTRY";
                        horizontal-stretch: 1;
                        text <=> root.add-station-country;
                    }
                }
                FormField {
                    label: "LOGO URL";
                    placeholder: "Optional";
                    text <=> root.add-station-logo;
                }
                HorizontalLayout {
                    padding-top: 4px;
                    spacing: 10px;
                    Rectangle { horizontal-stretch: 1; }
                    Rectangle {
                        width: 90px;
                        height: 32px;
                        border-radius: 16px;
                        background: add-station-cancel.has-hover ? Theme.hover-bg : transparent;
                        border-width: 1px;
                        border-color: Theme.border;
                        Text {
                            text: "Cancel";
                            color: Theme.text-dim;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        add-station-cancel := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.close-add-station(); }
                        }
                    }
                    Rectangle {
                        property <bool> ready: root.add-station-name != ""
                            && root.add-station-url != ""
                            && !root.add-station-saving
                            && !root.add-station-checking;
                        width: 130px;
                        height: 32px;
                        border-radius: 16px;
                        opacity: self.ready ? 1.0 : 0.5;
                        background: add-station-submit.has-hover && self.ready ? Theme.accent-hover : Theme.accent;
                        Text {
                            text: root.add-station-saving ? "Adding…" : "Add station";
                            color: Theme.on-accent;
                            font-size: 12px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        add-station-submit := TouchArea {
                            mouse-cursor: parent.ready ? pointer : default;
                            clicked => {
                                if (parent.ready) {
                                    root.submit-add-station();
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ── Playlist form (create / edit) ───────────────────────────────────────
    playlist-form-layer := Rectangle {
        visible: root.show-playlist-form;
        width: 100%;
        height: 100%;
        background: #000000a0;

        TouchArea {
            clicked => { root.show-playlist-form = false; }
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 420px;
            height: pl-form-content.preferred-height;
            border-radius: 14px;
            background: Theme.panel-bg;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-color: #000000aa;
            drop-shadow-blur: 40px;

            TouchArea {}

            pl-form-content := VerticalLayout {
                padding: 24px;
                spacing: 14px;
                Text {
                    text: root.pl-form-id == "" ? "New playlist" : "Edit playlist";
                    color: Theme.text;
                    font-size: 16px;
                    font-weight: 700;
                }
                pl-name-field := FormField {
                    label: "NAME";
                    placeholder: "My mix";
                    text <=> root.pl-form-name;
                }
                pl-desc-field := FormField {
                    label: "DESCRIPTION (OPTIONAL)";
                    text <=> root.pl-form-desc;
                }

                // Only offered when creating: turning an existing hand-picked
                // playlist into a generated one would silently discard the
                // tracks in it.
                if root.pl-form-id == "" : HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        horizontal-stretch: 1;
                        Text {
                            text: "Smart playlist";
                            color: Theme.text;
                            font-size: 12px;
                            font-weight: 600;
                        }
                        Text {
                            text: "Fills itself from a filter, and keeps itself up to date";
                            color: Theme.text-muted;
                            font-size: 10px;
                            wrap: word-wrap;
                        }
                    }
                    Toggle {
                        checked: root.pl-form-smart;
                        y: (parent.height - self.height) / 2;
                        toggled => {
                            root.pl-form-smart = !root.pl-form-smart;
                            if (root.pl-form-smart && root.pl-form-rsql != "") {
                                root.refresh-smart-preview();
                            }
                        }
                    }
                }

                if root.pl-form-smart : FilterBox {
                    text <=> root.pl-form-rsql;
                    runs: root.rsql-runs;
                    suggestions: root.rsql-suggestions;
                    selected: root.rsql-suggestion-index;
                    caret-bump: root.rsql-caret-bump;
                    caret-prefix: root.rsql-caret-prefix;
                    // Colouring and suggestions are local and cheap, so they
                    // update on every keystroke. The match count is a round
                    // trip, so it waits for the field to be left.
                    edited(value) => {
                        root.pl-form-preview-count = -1;
                        root.pl-form-preview-error = "";
                        root.rsql-edited(value);
                    }
                    committed(value) => { root.refresh-smart-preview(); }
                    accepted(suggestion) => { root.rsql-accept(suggestion); }
                    caret-moved(offset) => { root.rsql-caret-moved(offset); }
                    move-selection(delta) => {
                        root.rsql-suggestion-index = clamp(
                            root.rsql-suggestion-index + delta,
                            0,
                            max(0, root.rsql-suggestions.length - 1));
                    }
                }
                if root.pl-form-smart : Text {
                    text: root.pl-form-previewing
                        ? "Checking…"
                        : (root.pl-form-preview-error != ""
                            ? root.pl-form-preview-error
                            : (root.pl-form-preview-count < 0
                                ? root.rsql-hint
                                : (root.pl-form-preview-count == 1
                                    ? "1 track matches"
                                    : root.pl-form-preview-count + " tracks match")));
                    color: root.pl-form-preview-error != "" ? #d45769 : Theme.text-muted;
                    font-size: 10px;
                    wrap: word-wrap;
                }
                if root.pl-form-smart : HorizontalLayout {
                    spacing: 12px;
                    FormField {
                        label: "SORT BY";
                        placeholder: "e.g. playcount, random";
                        horizontal-stretch: 1;
                        text <=> root.pl-form-sort-by;
                        committed(value) => { root.refresh-smart-preview(); }
                    }
                    FormField {
                        label: "LIMIT";
                        placeholder: "0 = all";
                        horizontal-stretch: 1;
                        text <=> root.pl-form-limit;
                        committed(value) => { root.refresh-smart-preview(); }
                    }
                }
                if root.pl-form-smart : HorizontalLayout {
                    spacing: 10px;
                    Text {
                        text: "ORDER";
                        color: Theme.text-muted;
                        font-size: 10px;
                        letter-spacing: 1px;
                        vertical-alignment: center;
                    }
                    Dropdown {
                        options: ["Ascending", "Descending"];
                        current: root.pl-form-sort-order == "desc" ? 1 : 0;
                        menu-width: 150px;
                        selected(i) => {
                            self.current = i;
                            root.pl-form-sort-order = i == 1 ? "desc" : "asc";
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                HorizontalLayout {
                    padding-top: 4px;
                    spacing: 10px;
                    Rectangle { horizontal-stretch: 1; }
                    Rectangle {
                        width: 90px;
                        height: 32px;
                        border-radius: 16px;
                        background: cancel-touch.has-hover ? Theme.hover-bg : transparent;
                        border-width: 1px;
                        border-color: Theme.border;
                        Text {
                            text: "Cancel";
                            color: Theme.text-dim;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        cancel-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.show-playlist-form = false; }
                        }
                    }
                    Rectangle {
                        width: 110px;
                        height: 32px;
                        border-radius: 16px;
                        background: submit-touch.has-hover ? Theme.accent-hover : Theme.accent;
                        Text {
                            text: root.pl-form-id == "" ? "Create" : "Save";
                            color: Theme.on-accent;
                            font-size: 12px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        submit-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                if (root.pl-form-name != "") {
                                    if (root.pl-form-smart) {
                                        root.smart-playlist-submit(
                                            root.pl-form-id,
                                            root.pl-form-name,
                                            root.pl-form-desc,
                                            root.pl-form-rsql,
                                            root.pl-form-sort-by,
                                            root.pl-form-sort-order,
                                            root.pl-form-limit);
                                    } else {
                                        root.playlist-form-submit(root.pl-form-id, root.pl-form-name, root.pl-form-desc);
                                    }
                                    root.show-playlist-form = false;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ── Track picker (add tracks to the open playlist) ──────────────────────
    picker-layer := Rectangle {
        visible: root.show-track-picker;
        width: 100%;
        height: 100%;
        background: #000000a0;

        TouchArea {
            clicked => {
                root.show-track-picker = false;
                main-focus.focus();
            }
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: 84px;
            width: min(620px, parent.width - 80px);
            height: min(440px, parent.height - 168px);
            border-radius: 14px;
            background: Theme.panel-bg;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-color: #000000aa;
            drop-shadow-blur: 40px;
            clip: true;

            TouchArea {}

            VerticalLayout {
                HorizontalLayout {
                    padding: 18px;
                    spacing: 12px;
                    Image {
                        source: Icons.circle-plus;
                        colorize: Theme.accent;
                        width: 18px;
                        height: 18px;
                        y: (parent.height - self.height) / 2;
                    }
                    picker-scope := FocusScope {
                        height: 24px;
                        key-pressed(event) => {
                            if (event.text == Key.Escape) {
                                root.show-track-picker = false;
                                main-focus.focus();
                                return accept;
                            }
                            reject
                        }
                        picker-input := TextInput {
                            width: 100%;
                            height: 100%;
                            color: Theme.text;
                            font-size: 17px;
                            font-family: Theme.font-ui;
                            single-line: true;
                            vertical-alignment: center;
                            edited => { root.picker-query(self.text); }
                        }
                        if picker-input.text == "" : Text {
                            text: "Search tracks to add…";
                            color: Theme.text-muted;
                            font-size: 17px;
                            vertical-alignment: center;
                            height: 100%;
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }
                ListView {
                    vertical-stretch: 1;
                    for r[i] in root.picker-results : PaletteRow {
                        item: r;
                        selected: false;
                        activate => { root.picker-add(r.id); }
                        hovered => { }
                    }
                }
                if root.picker-results.length == 0 : Text {
                    text: "No matching tracks (already added tracks are hidden)";
                    color: Theme.text-muted;
                    font-size: 12px;
                    horizontal-alignment: center;
                    height: 40px;
                    vertical-alignment: center;
                }
                Rectangle { height: 1px; background: Theme.border; }
                HorizontalLayout {
                    padding: 10px;
                    padding-left: 18px;
                    spacing: 18px;
                    Text {
                        text: "click adds to \"" + root.pl-detail.name + "\"";
                        color: Theme.text-muted;
                        font-size: 10px;
                        font-family: Theme.font-mono;
                        overflow: elide;
                    }
                    Text {
                        text: "esc done";
                        color: Theme.text-muted;
                        font-size: 10px;
                        font-family: Theme.font-mono;
                    }
                }
            }
        }
    }

    // ── Server switcher ─────────────────────────────────────────────────────
    switcher-layer := Rectangle {
        visible: root.show-server-switcher;
        width: 100%;
        height: 100%;
        background: #000000a0;

        TouchArea {
            clicked => {
                root.show-server-switcher = false;
                main-focus.focus();
            }
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: 84px;
            width: min(560px, parent.width - 80px);
            height: min(420px, parent.height - 168px);
            border-radius: 14px;
            background: Theme.panel-bg;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-color: #000000aa;
            drop-shadow-blur: 40px;
            clip: true;

            TouchArea {}

            VerticalLayout {
                HorizontalLayout {
                    padding: 18px;
                    spacing: 12px;
                    Image {
                        source: Icons.broadcast;
                        colorize: Theme.accent;
                        width: 18px;
                        height: 18px;
                        y: (parent.height - self.height) / 2;
                    }
                    switcher-scope := FocusScope {
                        height: 24px;
                        key-pressed(event) => {
                            if (event.text == Key.DownArrow) {
                                root.switcher-sel = min(root.switcher-sel + 1, root.switcher-results.length - 1);
                                return accept;
                            }
                            if (event.text == Key.UpArrow) {
                                root.switcher-sel = max(root.switcher-sel - 1, 0);
                                return accept;
                            }
                            if (event.text == Key.Escape) {
                                root.show-server-switcher = false;
                                main-focus.focus();
                                return accept;
                            }
                            // Ctrl-N adds one without leaving the flow; a plain
                            // `n` would type into the filter.
                            if (event.modifiers.control && event.text == "n") {
                                root.show-server-switcher = false;
                                root.current-tab = 4;
                                root.server-error = "";
                                root.show-server-form = true;
                                return accept;
                            }
                            reject
                        }
                        switcher-input := TextInput {
                            width: 100%;
                            height: 100%;
                            color: Theme.text;
                            font-size: 17px;
                            font-family: Theme.font-ui;
                            single-line: true;
                            vertical-alignment: center;
                            edited => {
                                root.switcher-sel = 0;
                                root.switcher-query(self.text);
                            }
                            accepted => { root.activate-switcher(); }
                        }
                        if switcher-input.text == "" : Text {
                            text: "Search servers or type host:port…";
                            color: Theme.text-muted;
                            font-size: 17px;
                            vertical-alignment: center;
                            height: 100%;
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }
                ListView {
                    vertical-stretch: 1;
                    for r[i] in root.switcher-results : PaletteRow {
                        item: r;
                        selected: i == root.switcher-sel;
                        activate => {
                            root.switcher-sel = i;
                            root.activate-switcher();
                        }
                        hovered => { root.switcher-sel = i; }
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }
                HorizontalLayout {
                    padding: 10px;
                    padding-left: 18px;
                    spacing: 18px;
                    Text {
                        text: "enter connect";
                        color: Theme.text-muted;
                        font-size: 10px;
                        font-family: Theme.font-mono;
                    }
                    Text {
                        text: "C-n add";
                        color: Theme.text-muted;
                        font-size: 10px;
                        font-family: Theme.font-mono;
                    }
                    Text {
                        text: "esc close";
                        color: Theme.text-muted;
                        font-size: 10px;
                        font-family: Theme.font-mono;
                    }
                }
            }
        }
    }

    // ── Playlist picker (add track → chosen playlist) ───────────────────────
    plpicker-layer := Rectangle {
        visible: root.show-playlist-picker;
        width: 100%;
        height: 100%;
        background: #000000a0;

        TouchArea {
            clicked => {
                root.show-playlist-picker = false;
                main-focus.focus();
            }
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: 84px;
            width: min(520px, parent.width - 80px);
            height: min(400px, parent.height - 168px);
            border-radius: 14px;
            background: Theme.panel-bg;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-color: #000000aa;
            drop-shadow-blur: 40px;
            clip: true;

            TouchArea {}

            VerticalLayout {
                HorizontalLayout {
                    padding: 18px;
                    spacing: 12px;
                    Image {
                        source: Icons.playlist;
                        colorize: Theme.accent;
                        width: 18px;
                        height: 18px;
                        y: (parent.height - self.height) / 2;
                    }
                    plpicker-scope := FocusScope {
                        height: 24px;
                        key-pressed(event) => {
                            if (event.text == Key.DownArrow) {
                                root.plpicker-sel = min(root.plpicker-sel + 1, root.plpicker-results.length - 1);
                                return accept;
                            }
                            if (event.text == Key.UpArrow) {
                                root.plpicker-sel = max(root.plpicker-sel - 1, 0);
                                return accept;
                            }
                            if (event.text == Key.Escape) {
                                root.show-playlist-picker = false;
                                main-focus.focus();
                                return accept;
                            }
                            reject
                        }
                        plpicker-input := TextInput {
                            width: 100%;
                            height: 100%;
                            color: Theme.text;
                            font-size: 17px;
                            font-family: Theme.font-ui;
                            single-line: true;
                            vertical-alignment: center;
                            edited => {
                                root.plpicker-sel = 0;
                                root.plpicker-query(self.text);
                            }
                            accepted => { root.activate-plpicker(); }
                        }
                        if plpicker-input.text == "" : Text {
                            text: "Search playlists…";
                            color: Theme.text-muted;
                            font-size: 17px;
                            vertical-alignment: center;
                            height: 100%;
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }
                ListView {
                    vertical-stretch: 1;
                    for r[i] in root.plpicker-results : PaletteRow {
                        item: r;
                        selected: i == root.plpicker-sel;
                        activate => {
                            root.plpicker-sel = i;
                            root.activate-plpicker();
                        }
                        hovered => { root.plpicker-sel = i; }
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }
                HorizontalLayout {
                    padding: 10px;
                    padding-left: 18px;
                    spacing: 18px;
                    Text {
                        text: "enter adds the track";
                        color: Theme.text-muted;
                        font-size: 10px;
                        font-family: Theme.font-mono;
                    }
                    Text {
                        text: "esc close";
                        color: Theme.text-muted;
                        font-size: 10px;
                        font-family: Theme.font-mono;
                    }
                }
            }
        }
    }

    // ── Confirm playlist delete ─────────────────────────────────────────────
    confirm-delete-layer := Rectangle {
        visible: root.show-confirm-delete;
        width: 100%;
        height: 100%;
        background: #000000a0;

        TouchArea {
            clicked => { root.show-confirm-delete = false; }
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 400px;
            height: confirm-content.preferred-height;
            border-radius: 14px;
            background: Theme.panel-bg;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-color: #000000aa;
            drop-shadow-blur: 40px;

            TouchArea {}

            confirm-content := VerticalLayout {
                padding: 24px;
                spacing: 14px;
                Text {
                    text: "Delete playlist?";
                    color: Theme.text;
                    font-size: 16px;
                    font-weight: 700;
                }
                Text {
                    text: "\"" + root.confirm-delete-name + "\" will be permanently deleted. Its tracks stay in your library.";
                    color: Theme.text-dim;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    padding-top: 4px;
                    spacing: 10px;
                    Rectangle { horizontal-stretch: 1; }
                    Rectangle {
                        width: 90px;
                        height: 32px;
                        border-radius: 16px;
                        background: cdel-cancel.has-hover ? Theme.hover-bg : transparent;
                        border-width: 1px;
                        border-color: Theme.border;
                        Text {
                            text: "Cancel";
                            color: Theme.text-dim;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        cdel-cancel := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.show-confirm-delete = false; }
                        }
                    }
                    Rectangle {
                        width: 100px;
                        height: 32px;
                        border-radius: 16px;
                        background: cdel-ok.has-hover ? Theme.meter-high.brighter(0.2) : Theme.meter-high;
                        Text {
                            text: "Delete";
                            color: #ffffff;
                            font-size: 12px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        cdel-ok := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.playlist-delete(root.confirm-delete-id);
                                root.show-confirm-delete = false;
                            }
                        }
                    }
                }
            }
        }
    }

    // ── Help dialog ─────────────────────────────────────────────────────────
    help-layer := Rectangle {
        visible: root.show-help;
        width: 100%;
        height: 100%;
        background: #000000a0;

        TouchArea {
            clicked => { root.show-help = false; }
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 380px;
            height: help-content.preferred-height;
            border-radius: 14px;
            background: Theme.panel-bg;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-color: #000000aa;
            drop-shadow-blur: 40px;

            TouchArea {}

            help-content := VerticalLayout {
                padding: 24px;
                spacing: 14px;
                Text {
                    text: "Keyboard shortcuts";
                    color: Theme.text;
                    font-size: 16px;
                    font-weight: 700;
                }
                HelpRow { keys: "/"; label: "Search library"; }
                HelpRow { keys: "r"; label: "Search internet radio"; }
                HelpRow { keys: "n"; label: "New playlist"; }
                HelpRow { keys: "space"; label: "Play / pause"; }
                HelpRow { keys: "up / down"; label: "Navigate search results"; }
                HelpRow { keys: "enter"; label: "Play selection"; }
                HelpRow { keys: "e"; label: "Audio settings (EQ, replaygain…)"; }
                HelpRow { keys: "s"; label: "Cycle skin"; }
                HelpRow { keys: "q"; label: "Show / hide the play queue"; }
                HelpRow { keys: "b"; label: "Show / hide the sidebar"; }
                HelpRow { keys: "v"; label: "Show / hide the equalizer"; }
                HelpRow { keys: "+ / -"; label: "Volume up / down"; }
                HelpRow { keys: "m"; label: "Mute / unmute"; }
                HelpRow { keys: "f"; label: "Fullscreen player (while playing)"; }
                HelpRow { keys: "esc"; label: "Close dialog / go back"; }
                HelpRow { keys: "?"; label: "Show this help"; }
            }
        }
    }
}

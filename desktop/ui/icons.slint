// Lucide-style stroke SVGs for the music-player desktop client. All are
// stroke="currentColor" so they tint cleanly via Image.colorize.

export global Icons {
    out property <image> disc: @image-url("../assets/icons/disc.svg");
    out property <image> artist: @image-url("../assets/icons/artist.svg");
    out property <image> list-music: @image-url("../assets/icons/list-music.svg");
    out property <image> music: @image-url("../assets/icons/music.svg");
    out property <image> heart: @image-url("../assets/icons/heart.svg");
    out property <image> search: @image-url("../assets/icons/search.svg");
    out property <image> play: @image-url("../assets/icons/play.svg");
    out property <image> pause: @image-url("../assets/icons/pause.svg");
    out property <image> prev: @image-url("../assets/icons/prev.svg");
    out property <image> next: @image-url("../assets/icons/next.svg");
    out property <image> volume: @image-url("../assets/icons/volume-2.svg");
    out property <image> volume-mute: @image-url("../assets/icons/volume-mute.svg");
    out property <image> settings: @image-url("../assets/icons/settings.svg");
    out property <image> chevron-left: @image-url("../assets/icons/chevron-left.svg");
    out property <image> shuffle: @image-url("../assets/icons/shuffle.svg");
    out property <image> repeat: @image-url("../assets/icons/repeat.svg");
    out property <image> equalizer: @image-url("../assets/icons/equalizer.svg");
    out property <image> panel-left: @image-url("../assets/icons/panel-left.svg");
    out property <image> panel-right: @image-url("../assets/icons/panel-right.svg");
    out property <image> panel-left-filled: @image-url("../assets/icons/panel-left-filled.svg");
    out property <image> panel-right-filled: @image-url("../assets/icons/panel-right-filled.svg");
    out property <image> broadcast: @image-url("../assets/icons/broadcast.svg");
    out property <image> server: @image-url("../assets/icons/server.svg");
    out property <image> folder: @image-url("../assets/icons/directory.svg");
    out property <image> navidrome: @image-url("../assets/icons/navidrome.svg");
    out property <image> jellyfin: @image-url("../assets/icons/jellyfin.svg");
    out property <image> trash: @image-url("../assets/icons/trash.svg");
    out property <image> playlist: @image-url("../assets/icons/playlist.svg");
    out property <image> pencil: @image-url("../assets/icons/pencil.svg");
    out property <image> circle-plus: @image-url("../assets/icons/circle-plus.svg");
    out property <image> close: @image-url("../assets/icons/x.svg");
    out property <image> ellipsis: @image-url("../assets/icons/ellipsis.svg");
    out property <image> heart-outline: @image-url("../assets/icons/heart-outline.svg");
    out property <image> refresh: @image-url("../assets/icons/refresh.svg");
    out property <image> extension: @image-url("../assets/icons/extension.svg");
}

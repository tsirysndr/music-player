{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Music Player",
  "version": "0.2.1",
  "identifier": "music-player",
  "build": {
    "beforeBuildCommand": "bun run tauri:build",
    "beforeDevCommand": "bun run tauri:dev",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "fullscreen": false,
        "height": 800,
        "resizable": true,
        "title": "Music Player",
        "width": 1400
      }
    ],
    "security": {
      "csp": "img-src 'self' asset: http://asset.localhost https://asset.localhost data:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/covers/*",
          "$APPLOCALDATA/covers/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "copyright": "",
    "externalBin": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "longDescription": "",
    "shortDescription": "",
    "resources": [],
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  }
}
